# ============================================================================
#  harness · TARGET=qa   (E2E_TARGET=qa)
# ============================================================================
#  Front DESPLEGADO de staging; BD/API/APP_KEY son COPIA de dev (comparten backend).
#  ⚠ Si rotan las credenciales de dev, actualizá dev Y staging.
#  Gitignoreado. Plantilla: .env.staging.example.

# ── Base de datos · = dev (RDS COMPARTIDA — copia de dev) ──
E2E_DB_HOST=
E2E_DB_PORT=
E2E_DB_NAME=
E2E_DB_USER=
E2E_DB_PASS=

# ── API + cripto ──
# ⚠ El backend de este target NO es el de dev. En el cluster `inertia-develop` conviven DOS servicios:
#   · legacy-backend             → sirve la rama `develop`   (ese es el target `dev`)
#   · legacy-backend-qa          → sirve la rama `qa`        (ESTE)
# Van acá: http://legacy-backend-qa.inertia-develop/api
# Apuntarlo al de dev mezcla ambientes: el front desplegado sería de qa y el backend de develop, así que
# validás código que no es el que está en el front (nos costó varias corridas: Ábaco respondía con la
# lógica vieja porque `develop` no tenía el cambio, y parecía un bug del feature).
# La BD sí es COMPARTIDA con dev (las credenciales de arriba son las mismas); lo distinto es el API.
E2E_API_BASE_URL=
APP_KEY=

# ── Frontend · DESPLEGADO (el de qa: originaciones-qa.dev.creditop.com) ──
E2E_BASE_URL=

# ── Pre-aprobaciones ──
E2E_REAL_PREAPPROVALS=

# ── Cognito · pool de STAGING (oscar+dentix) ──
#  oscar+dentix es la cuenta de staging que ANDA. La CONTRASEÑA va abajo y la ponés VOS
#  (queda vacía en el repo/archivo a propósito).
#  ⚠ miguel-test@creditop.com quedó PENDIENTE: su login NO se confirmó — Cognito rechaza la
#    contraseña (password123+) tanto en dev como en staging (2026-07-22). La "validación" previa
#    fue un FALSO POSITIVO: warm-session reusó una sesión ya cacheada (de oscar+dentix), no logueó
#    a miguel-test. Cuando Oscar confirme la clave/estado real de miguel-test, se hace el swap
#    (E2E_COGNITO_USER + E2E_ASESOR_SUB del pool que corresponda).
E2E_COGNITO_USER=
E2E_COGNITO_PASS=
# sub de oscar+dentix en el pool de staging
E2E_ASESOR_SUB=

# ── Loki · forense de logs (pkg/loki.ts · dev/loki-trace.ts) ──
# Para qué: al cerrar una corrida, EXPLICAR la causa. Loki NO juzga — el veredicto es de la BD
# (pkg/trace.ts). Detalle en playground/trazador/README.md y en la sección de este CLAUDE.md.
#
# MISMO stack y MISMAS credenciales que dev (verificado): creditopdev sirve los dos. Lo que cambia es
# el ambiente — staging es la rama qa y aparece como service_name=legacy-backend-qa / environment=qa.
E2E_LOKI_ENABLED=true
E2E_LOKI_URL=https://logs-prod-036.grafana.net
E2E_LOKI_USER=1339770
E2E_LOKI_TOKEN=
# Valores de `environment` de ESTE target (alternativa de regex). ⚠ NO es opcional cuando el stack es
# compartido: dev y staging comparten stack Y base de datos, así que el mismo uReq tiene líneas de las
# dos ramas. Sin este filtro el forense mezcla qué CÓDIGO atendió la solicitud.
E2E_LOKI_ENV=qa
# Esperar antes de consultar: LokiHandler batchea de a 100 líneas y hace flush al morir el proceso, y
# encima hay lag de ingesta. Consultar en vivo deja huecos que se leen como "no pasó nada".
E2E_LOKI_SETTLE_MS=10000
# Ensancha la ventana a los dos lados: el reloj del Mac y el del servidor no coinciden.
E2E_LOKI_PAD_MS=60000

# ─── PostHog · la TERCERA fuente: qué VIO el cliente, con el vocabulario del embudo ─────────────────
# UN solo proyecto (238530 «Loan Request») para TODOS los ambientes, separados por `properties.environment`.
# ⚠ Es una PERSONAL API KEY (`phx_`), no el `phc_` del snippet del front: ese es de escritura y da 401.
E2E_POSTHOG_TOKEN=
E2E_POSTHOG_PROJECT=238530
# `environment` que escribe el FRONT de este target (getRuntimeEnvironment: APP_ENV, y local → «dev»).
E2E_POSTHOG_ENV=staging
# El servidor del front batchea (flushAt 10 · flushInterval 5 s): consultar en vivo deja huecos.
E2E_POSTHOG_SETTLE_MS=8000
# La ingesta tarda (medido: 1 min después de cerrar, 4 de 18 eventos). Se sondea cada 15 s hasta que el
# conjunto deje de crecer, con este techo.
E2E_POSTHOG_MAX_WAIT_MS=120000
