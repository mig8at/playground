{
  "manifest_version": 3,
  "name": "Probeta · CreditOp",
  "version": "0.1.0",
  "description": "Probeta: el laboratorio de pruebas a mano del wizard. Arranca cada prueba con una persona nueva, le dicta las centrales, rellena, aprueba la identidad, muestra el OTP, el recorrido y la base de la solicitud. Habla con el panel del harness (localhost:5195).",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5195/*",
    "http://127.0.0.1:5195/*",
    "https://*.dev.creditop.com/*",
    "http://localhost:5174/*",
    "http://127.0.0.1:5174/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Probeta",
    "default_icon": {
      "16": "icons/probeta-16.png",
      "32": "icons/probeta-32.png",
      "48": "icons/probeta-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dev.creditop.com/*",
        "http://localhost:5174/*",
        "http://127.0.0.1:5174/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/probeta-16.png",
    "32": "icons/probeta-32.png",
    "48": "icons/probeta-48.png",
    "128": "icons/probeta-128.png"
  }
}
