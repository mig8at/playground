# harness/.env.prod.example — SOLO LECTURA: leer el embudo y los logs del front de PRODUCCIÓN.
# No hay credenciales de BD acá a propósito: contra prod el harness no corre nada, sólo lee PostHog.
E2E_TARGET_READONLY=1

# ─── PostHog · SOLO LECTURA (el trazador y el harness leen; nadie escribe desde acá) ────────────────
# ⚠ prod es SOLO LECTURA, siempre. Estas claves sirven para leer el embudo y los logs del front.
E2E_POSTHOG_TOKEN=
E2E_POSTHOG_PROJECT=238530
E2E_POSTHOG_ENV=production
E2E_POSTHOG_SETTLE_MS=8000
E2E_POSTHOG_MAX_WAIT_MS=120000
