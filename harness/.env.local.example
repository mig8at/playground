# ============================================================================
#  harness · TARGET=local   (E2E_TARGET=local)
# ============================================================================
#  Todo local/mockeado: BD y backend en Docker, externos por mocks. No toca nada
#  compartido. AUTOSUFICIENTE. Gitignoreado. Plantilla: .env.local.example.

# ── Base de datos · Docker local ──
# 127.0.0.1 (contenedor MySQL local)
E2E_DB_HOST=
E2E_DB_PORT=
E2E_DB_NAME=
E2E_DB_USER=
E2E_DB_PASS=
# nombres de contenedor (los usa dbops/sail)
E2E_DB_CONTAINER=
E2E_APP_CONTAINER=

# ── API + cripto ──
E2E_API_BASE_URL=
# APP_KEY local (des/encripta Experian)
APP_KEY=

# ── Frontend + mocks ──
# wizard local
E2E_BASE_URL=
# base de los mocks locales
E2E_MOCK_URL=

# ── Flujo ──
E2E_PARTNER_HASH=
# asesor | ecommerce
E2E_CHANNEL=
# monto por defecto de la solicitud
E2E_AMOUNT=
# puerto del mock-store (ecommerce)
E2E_SHOP_PORT=
E2E_WEBHOOK_URL=

# ── Loki · forense de logs (pkg/loki.ts · dev/loki-trace.ts) ──
# Para qué: al cerrar una corrida, EXPLICAR la causa. Loki NO juzga — el veredicto es de la BD
# (pkg/trace.ts). Detalle en playground/trazador/README.md y en la sección de este CLAUDE.md.
#
# Apunta a un LOKI LOCAL en Docker: `bin/loki-local start`. Misma decisión que con MySQL — no se mockea
# el motor, se corre el real. Sin credenciales porque un Loki local no las pide.
#
# ⚠ NO apuntes esto al Loki de dev. Con la BD funciona (leés las filas que tu corrida escribió); con Loki
# NO, porque tu corrida local no escribió allá: leerías la corrida de otro cuyo user_request_id coincide.
# Y coincide — la BD local es un dump de dev y los id avanzan en el mismo rango (medido 2026-08-04: local
# 464664, dev 464620). `pkg/loki.ts:porQueNo` lo BLOQUEA, no es solo un consejo.
#
# El trace_id lo aporta TEMPO, no Loki: `bin/tempo-local start` + en el .env del backend local
# GRAFANA_TEMPO_ENABLED=true y GRAFANA_TEMPO_ENDPOINT=http://host.docker.internal:4318/v1/traces. Sin eso
# `initializeOpenTelemetry()` sale temprano, no hay span y ninguna línea lleva trace.
#
# El forense tiene TRES modos, y elige solo (todos se anuncian en pantalla):
#   1. completo   ancla por uReq + expande por trace_id → las ~18 líneas de la petición
#   2. degradado  hay ancla pero sin trace_id → solo las líneas que nombran el uReq
#   3. ventana    no hay ancla → todo lo logueado en la ventana. SOLO con Loki local (sos el único que
#                 escribe); contra uno compartido serían corridas ajenas, y está atado a la URL, no a una
#                 perilla. En local suele caer acá: el camino de `select` no loguea el uReq en su context.
E2E_LOKI_ENABLED=true
E2E_LOKI_URL=http://localhost:3100
E2E_LOKI_USER=
E2E_LOKI_TOKEN=
# Valores de `environment` de ESTE target (alternativa de regex). ⚠ NO es opcional cuando el stack es
# compartido: dev y staging comparten stack Y base de datos, así que el mismo uReq tiene líneas de las
# dos ramas. Sin este filtro el forense mezcla qué CÓDIGO atendió la solicitud.
E2E_LOKI_ENV=local
# Esperar antes de consultar: LokiHandler batchea de a 100 líneas y hace flush al morir el proceso, y
# encima hay lag de ingesta. Consultar en vivo deja huecos que se leen como "no pasó nada".
E2E_LOKI_SETTLE_MS=3000
# Ensancha la ventana a los dos lados: el reloj del Mac y el del servidor no coinciden.
E2E_LOKI_PAD_MS=60000
