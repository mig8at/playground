#!/usr/bin/env bash
# asesor — demo del wizard de originaciones contra DEV. Solo 4 comandos (sin flags):
#   bin/advisor <merchant>           → login de ASESOR (Cognito real) y queda en MONTO; manejás vos a mano.
#   bin/advisor <merchant> auto      → GUIADO: siembra cada pantalla, vos das "Continuar"; en /lenders elegís
#                                     el lender y el demo sigue (CreditopX abre 2ª ventana B; aggregator/redirect, 1).
#   bin/ecommerce <merchant> [auto] → idem, pero ENTRA POR EL CHECKOUT de la tienda mock (no login de asesor).
# Lee .flows.json (asesor.email/sub + merchants.<m>.branch_hash) y .cognito.json (login del asesor). El wizard
# local (Vite) apunta a DEV; se reusa si está arriba (se reinicia solo si apuntaba a otro backend).
set -euo pipefail

E2E="${CFE_E2E:-$HOME/Desktop/CREDITOP/playground/harness}"
# ⚠ `CFE_FRONT` tiene DOS sentidos históricos y colisionaban: abajo es el SWITCH de front
# (`local|ambiente`, que es lo que manda el panel) y acá se usaba como la RUTA del monorepo. Con
# `CFE_FRONT=local` la ruta quedaba en `local/apps/loan-request-wizard` → `cd: No such file or directory`,
# el wizard no arrancaba y el script igual esperaba 480s "compilando" antes de rendirse.
# Se resuelve por VALOR y se conserva la compatibilidad: si es uno de los dos modos, es un modo; cualquier
# otro valor sigue tomándose como ruta (y `CFE_FRONT_PATH` la fija explícita).
case "${CFE_FRONT:-}" in
  local|ambiente|'') FRONT="${CFE_FRONT_PATH:-$HOME/Desktop/CREDITOP/github/frontend-monorepo}" ;;
  *)                 FRONT="$CFE_FRONT" ;;
esac
WIZARD="$FRONT/apps/loan-request-wizard"
FLOWS="$E2E/.flows.json"
TARGET="${CFE_TARGET:-dev}"   # dev por default; CFE_TARGET=local prueba el stack local (sail) sin commitear a dev

# Lee una clave por la CADENA de env del target (process.env > .env.<target> > env/<target>.env > heredado).
# Reemplaza a los `grep '^CLAVE=' .env.$TARGET`: desde la partición, los HECHOS del entorno (API, BD) viven
# COMPARTIDOS en `env/<target>.env`, así que greppear solo el archivo propio ya no los encuentra. Y peor:
# bajo `set -euo pipefail` un grep sin match devuelve 1, pipefail lo propaga y el script MUERE mudo en la
# asignación (F-59). El `|| true` acá es la red: si la clave no está, la variable queda vacía y decide el
# fallback de cada caso, no la muerte del script.
# `bin/advisor` se puede invocar desde `harness/` o desde la raíz `playground/`
# (así lo llama el panel). `env-get.ts` busca .env.<target> desde cwd; si lo
# ejecutábamos antes del `cd "$E2E"`, la corrida local no leía harness/.env.local,
# caía al fallback de DEV y el wizard terminaba en legacy-backend.inertia-develop.
# Resolver siempre desde el directorio del harness evita que el lugar desde el
# que se lanzó el comando cambie el backend que atiende la prueba.
envget() { ( cd "$E2E" && E2E_TARGET="$TARGET" node "$E2E/bin/env-get.ts" "$1" "${2:-}" ) 2>/dev/null || true; }

# La URL del front sale de la cadena de env por TARGET, no hardcodeada: `staging` corre contra un
# frontend REMOTO ya desplegado. Si es remoto no hay wizard local que levantar ni .env que mover.
WIZ_BASE="$(envget E2E_BASE_URL "http://localhost:5174")"
[ -n "$WIZ_BASE" ] || WIZ_BASE="http://localhost:5174"

# SWITCH del front (`CFE_FRONT`; lo manda el panel y también sirve a mano):
#   local     → el wizard de Vite en :5174, o sea TU working copy del monorepo, contra el backend del
#               target. Es la razón de ser del switch: ver un cambio del front contra `qa` SIN esperar
#               el deploy. Lo que cambia es solo QUÉ front se abre; backend, BD y mocks siguen siendo
#               los del target.
#   ambiente  → el front YA DESPLEGADO del target (lo que diga su E2E_BASE_URL).
#   vacío     → lo que diga la cadena del target (comportamiento previo: dev local · staging desplegado).
# Se resuelve por la CADENA y no con una lista de targets: el día que `dev` tenga front desplegado,
# ponerlo en su `.env.dev` alcanza para que las dos opciones existan solas (mismo criterio que
# E2E_REAL_PREAPPROVALS — una lista escrita a mano se desincroniza).
case "${CFE_FRONT:-}" in
  local) WIZ_BASE="http://localhost:5174" ;;
  ambiente)
    case "$WIZ_BASE" in
      http://localhost*|http://127.0.0.1*)
        echo "✗ '$TARGET' no tiene front desplegado: su E2E_BASE_URL es $WIZ_BASE."
        echo "  Corré con el front local, o poné la URL del deploy en .env.$TARGET."
        exit 1 ;;
    esac ;;
  '') ;;
  *) echo "✗ CFE_FRONT inválido: '${CFE_FRONT}'. Usá: local | ambiente (o vacío = lo que diga el target)."; exit 1 ;;
esac

REMOTE_FRONT=0
case "$WIZ_BASE" in http://localhost*|http://127.0.0.1*) ;; *) REMOTE_FRONT=1 ;; esac
FRESH=0

# PREFLIGHT: la configuración del target tiene que ser coherente ANTES de escribir nada. Tres bugs de la
# misma familia (F-59 · F-64 · F-65) se hubieran cazado acá, en un segundo, en vez de a los cinco minutos
# con un 500 opaco y basura huérfana en la base compartida.
# E2E_BASE_URL va con el valor EFECTIVO (ya aplicado el switch): si no, el preflight informaría el front
# del `.env` mientras la corrida abre otro, que es justo el tipo de mentira que este chequeo existe para
# evitar. El front no hace fallar al preflight (es informativo a propósito), pero tiene que decir la verdad.
if ! E2E_TARGET="$TARGET" E2E_BASE_URL="$WIZ_BASE" node "$(dirname "$0")/preflight.ts" >/dev/null 2>&1; then
  E2E_TARGET="$TARGET" E2E_BASE_URL="$WIZ_BASE" node "$(dirname "$0")/preflight.ts" || true
  echo "✗ no se corre: la configuración de '$TARGET' es incoherente (ver arriba)."
  exit 1
fi

MERCHANT="${1:-pullman}"
GUIDED=0; [ "${2:-}" = "auto" ] && GUIDED=1
# PREBOOT: precalienta el wizard y sale, SIN correr el spec y SIN tocar la BD (ni assign ni scrub). Existe
# porque el cold-boot de Vite se pagaba DENTRO de la corrida: 304s medidos el 2026-08-19 contra los ~11s
# que tarda cuando ya está tibio. El panel lo dispara al abrirse; por terminal es `bin/advisor <x> preboot`.
PREBOOT=0; [ "${2:-}" = "preboot" ] && PREBOOT=1
# el comercio va PRIMERO: `auto` solo es el 2º arg. `bin/ecommerce auto` (sin comercio) es un error típico.
[ "$MERCHANT" = "auto" ] && { echo "✗ el comercio va PRIMERO. Ej: bin/advisor pullman auto · bin/ecommerce pullman auto"; exit 1; }
[ -n "${2:-}" ] && [ "${2:-}" != "auto" ] && [ "${2:-}" != "preboot" ] && { echo "✗ 2º arg inválido: '${2}'. Usá: bin/advisor <comercio> [auto [success|rejected|pending] | preboot]"; exit 1; }
# 3er posicional (SOLO con `auto`): cómo RESUELVE el crédito → success (default) | rejected | pending.
RESULT="${3:-success}"
case "$RESULT" in success|rejected|pending) ;; *) echo "✗ status inválido: '$RESULT'. Usá: success | rejected | pending"; exit 1;; esac
ENTRY="${CFE_ENTRY:-cognito}"               # bin/ecommerce exporta CFE_ENTRY=ecommerce
ECOMMERCE=0; [ "$ENTRY" = "ecommerce" ] && ECOMMERCE=1
# Canales SIN asesor. Comparten que no hay a quién asignarle la sucursal ni sesión que renovar, pero
# entran por puertas distintas: `self-service` es el cliente que va solo por el tronco normal del
# wizard, `qr` es la caja de un comercio Corbeta. ⚠ Saltear `load-permiso` acá no es sólo ahorro: ese
# paso BORRA el cache de sesión de Cognito cuando la asignación cambia, y hacerlo para un canal que ni
# loguea le rompe la próxima corrida del asesor.
SIN_ASESOR=0; { [ "$ENTRY" = "self-service" ] || [ "$ENTRY" = "qr" ]; } && SIN_ASESOR=1

# env que lee el spec (dev/guided.spec.ts cubre GUIADO y MANUAL según E2E_GUIDED)
export E2E_TARGET="$TARGET" E2E_BASE_URL="$WIZ_BASE" E2E_ENTRY="$ENTRY" E2E_GUIDED="$GUIDED" E2E_RESULT="$RESULT" E2E_PREVIEW=1

# El POOL de Cognito lo trae el FRONT, no el target: el wizard local usa su propio `.env` del monorepo
# (login.creditop.com = pool de dev) y acá solo le pisamos las URLs de API. Así que con front LOCAL hay que
# loguear con la cuenta de ESE pool; la de `.env.staging` (otro pool) se queda dando vueltas en el login.
# Vaciar las variables hace que `loadCognitoCreds` caiga a `.cognito.json`, que es la cuenta del pool de dev.
# Funciona porque dev y staging COMPARTEN LA BD: el `sub` del asesor es el mismo para los dos backends.
if [ "$REMOTE_FRONT" = 0 ] && [ "$TARGET" != "local" ] && [ "$TARGET" != "dev" ]; then
  export E2E_COGNITO_USER="" E2E_COGNITO_PASS=""
  echo "  ● cognito       front local → pool de dev: se loguea con la cuenta de .cognito.json (no la de .env.$TARGET)"
fi

log() { printf '▶ %s\n' "$*"; }
step() { printf '  ○ %-13s …\n' "$1"; }
ok()   { printf '  ● %-13s %s\n' "$1" "${2:-ok}"; }
cd "$E2E"
[ -f "$FLOWS" ] || { echo "✗ falta $FLOWS (asesor.email/sub + merchants.<m>.branch_hash)"; exit 1; }

# lee una ruta dot-path del .flows.json (sin jq; node siempre está)
fget() { node -e 'const fs=require("fs");let j={};try{j=JSON.parse(fs.readFileSync(process.argv[1]))}catch(e){};let v=j;for(const k of process.argv[2].split(".")){v=(v==null?undefined:v[k])};process.stdout.write(v==null?"":String(v))' "$FLOWS" "$1"; }
json_pick() { node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const j=JSON.parse(s);const v=eval("j"+process.argv[1]);process.stdout.write(v==null?"":String(v))}catch(e){}})' "$1"; }

# El asesor es POR TARGET. `.flows.json` describe al de dev; staging entra por OTRO pool de Cognito, así
# que la MISMA persona tiene otro `sub` — y como el backend y la BD son los mismos para dev y staging, el
# backend no la reconoce y el wizard responde "No tienes un comercio asignado" (F-61). Si `.env.<target>`
# define E2E_ADVISOR_SUB / E2E_COGNITO_USER, mandan ellos.
EMAIL="$(fget asesor.email)"; SUB="$(fget asesor.sub)"
OV="$(envget E2E_ADVISOR_SUB)";   [ -z "$OV" ] && OV="$(envget E2E_ASESOR_SUB)"   # el nombre viejo sigue andando
[ -n "$OV" ] && SUB="$OV"
OV="$(envget E2E_COGNITO_USER)"; [ -n "$OV" ] && EMAIL="$OV"
[ -n "$EMAIL" ] && [ -n "$SUB" ] || { echo "✗ sin asesor: definí E2E_ADVISOR_SUB en .env.$TARGET o asesor.email/sub en $FLOWS"; exit 1; }
export E2E_ADVISOR_SUB="$SUB"   # lo usa el spec (salto headless a /lenders) para el corporate_user_id del uReq
# ⚠ EL HASH DE LA SUCURSAL NO ES EL MISMO EN TODAS LAS BASES, así que primero se mira el mapa POR
# TARGET. Una sucursal es una fila con su propio hash en cada base: el comercio peruano se sembró a
# mano en local (`montar-peru`) y ahí quedó `50e007e4`, mientras que en la base compartida de dev/qa
# es `a8221e67`. Con el hash de local contra qa, el `assign` de abajo falla —esa sucursal no existe
# allá— y la corrida muere antes de abrir el navegador. Medido el 2026-09-09 lanzando el panel
# contra qa.
#
# El panel YA resolvía esto bien (`branchHashForSlug` en `panel/server.ts` mira `por_target`), pero
# lanza este script y acá se leía `branch_hash` a secas: dos lugares con la misma pregunta y una sola
# respuesta correcta. `por_target` es opcional — un comercio que viene del volcado tiene el mismo hash
# en todas las bases y no declara nada.
HASH="$(fget "merchants.$MERCHANT.por_target.$TARGET")"
[ -n "$HASH" ] || HASH="$(fget "merchants.$MERCHANT.branch_hash")"
# El panel puede pasar una sucursal ELEGIDA en el buscador, que no está quemada en `.flows.json`:
# ahí el argumento ES el hash de la sucursal. Así se corre contra cualquier comercio de la base.
# (`case` y no un grep encadenado: bajo `set -e` un `a && b && c` con un eslabón falso es una trampa.)
if [ -z "$HASH" ]; then
  case "$MERCHANT" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) HASH="$MERCHANT" ;;
  esac
fi
# Teléfono de prueba para bypasear el OTP (setting `qa_otp_bypass_phones` → el OTP son sus últimos 4).
#
# ⚠ EL GLOBAL NO SIRVE PARA CUALQUIER COMERCIO: el largo del celular lo dicta el PAÍS del comercio
# (`countries.cell_phone_lenght`), y el default `3131010101` es colombiano, de 10 dígitos. Contra el
# comercio peruano —que pide 9— la corrida muere en la primera pantalla con «Ocurrió un error», que se
# lee como un problema del caso y es de la configuración. Por eso el comercio puede traer el suyo.
# Medido el 2026-09-09 lanzando el panel contra qa.
#
# El que se ponga acá tiene que estar en el setting, o la pantalla del código no se pasa.
BYPASS_PHONE="$(fget "merchants.$MERCHANT.otp_bypass_phone")"
[ -n "$BYPASS_PHONE" ] || BYPASS_PHONE="$(fget otp_bypass_phone)"
[ -n "$BYPASS_PHONE" ] || BYPASS_PHONE="3131010101"
export E2E_OTP_BYPASS_PHONE="$BYPASS_PHONE"

# ── entrada ECOMMERCE: arma el checkout (base64) + el return_url a la tienda mock por HTTP (el shim) ──
if [ "$ECOMMERCE" = 1 ]; then
  # return_url = tienda mock por HTTP (el botón "volver al comercio" navega por el browser → un file:// lo
  # bloquea). Se exporta ANTES de armar el contrato (ecommerce-url lo lee); el shim sirve el mock-store en /return.
  if [ -z "${E2E_RETURN_URL:-}" ]; then
    "$(dirname "$0")/mock-redirect" start >/dev/null 2>&1 || true
    export E2E_RETURN_URL="http://localhost:${MOCK_REDIRECT_PORT:-8096}/return"
    log "return_url → tienda mock (shim :${MOCK_REDIRECT_PORT:-8096}/return)"
  fi
  # || true: si el comercio NO tiene credencial ecommerce, dbops sale 1 → llegamos al mensaje claro de abajo.
  #
  # El MONTO del panel va como 3er argumento, y la identidad viaja por las E2E_SYNTH_* que el panel ya
  # exporta (las lee `identidadDelCaso()` en pkg/ecommerce.ts). Sin esto el contrato salía con los
  # valores fijos del helper —CC 1032456789 · SYNTH ECOM · $600.000— y el canal dejaba de probar EL
  # CASO que elegiste: el panel anunciaba una identidad y un monto, y por la tienda entraba otro.
  # Medido el 2026-09-14: panel «CC 2941056394 · $2.000.000» → contrato «CC 1032456789 · $600.000».
  EURL="$(node bin/dbops.ts ecommerce-url "$MERCHANT" "$BYPASS_PHONE" "${E2E_AMOUNT:-}" 2>/dev/null)" || true
  ECHASH="$(printf '%s' "$EURL" | json_pick '.hash')"
  ECPATH="$(printf '%s' "$EURL" | json_pick '.checkout_path')"
  [ -n "$ECHASH" ] && [ -n "$ECPATH" ] || { echo "✗ '$MERCHANT' no tiene checkout ecommerce (sin credencial). Usá bin/advisor (login de asesor)."; exit 1; }
  HASH="$ECHASH"
  export E2E_CHECKOUT_URL="${WIZ_BASE}$ECPATH"
  export E2E_STORE=1                          # el spec entra por la tienda mock antes del checkout
  printf '▶ checkout ecommerce: %s/ecommerce/%s/checkout  (payload base64 omitido)\n' "$WIZ_BASE" "$ECHASH"
fi

# comercio no registrado en .flows.json → resolver en dev y cachear
if [ -z "$HASH" ]; then
  log "comercio '$MERCHANT' no está en .flows.json — lo resuelvo en dev y lo cacheo"
  HASH="$(node bin/dbops.ts list "$MERCHANT" 2>/dev/null | json_pick '[0].hash')"
  [ -n "$HASH" ] || { echo "✗ no pude resolver '$MERCHANT' en dev (probá: node bin/dbops.ts list $MERCHANT)"; exit 1; }
  node -e 'const fs=require("fs"),f=process.argv[1],m=process.argv[2],h=process.argv[3];const j=JSON.parse(fs.readFileSync(f));j.merchants=j.merchants||{};j.merchants[m]=Object.assign({},j.merchants[m],{branch_hash:h});fs.writeFileSync(f,JSON.stringify(j,null,2)+"\n")' "$FLOWS" "$MERCHANT" "$HASH"
  echo "  ✓ $MERCHANT → $HASH (cacheado en .flows.json)"
fi
export E2E_ADVISOR_HASH="$HASH"

# ── permiso al asesor (un asesor = un comercio); ecommerce entra por checkout, sin asesor ──
step "load-permiso"
if [ "$PREBOOT" = 1 ]; then
  ok "load-permiso" "n/a (preboot: no se toca la BD)"
elif [ "$ECOMMERCE" = 1 ]; then
  ok "load-permiso" "n/a (ecommerce, sin asesor)"
elif [ "$SIN_ASESOR" = 1 ]; then
  ok "load-permiso" "n/a (${ENTRY}, sin asesor)"
else
  CUR="$(node bin/dbops.ts whois "$SUB" 2>/dev/null | json_pick '.matches[0].allied_branch_hash')"
  if [ "$CUR" = "$HASH" ]; then
    ok "load-permiso" "ya en '$MERCHANT' ($HASH) — sin write"
  else
    # query = SUB (cognito_id): el assign matchea/crea la fila users por cognito_id (el email puede diferir).
    I_KNOW_THIS_TOUCHES_SHARED_DEV=1 node bin/dbops.ts assign "$SUB" "$MERCHANT" "$HASH" "$SUB" >/dev/null \
      || { echo "✗ falló el assign (corré: node bin/dbops.ts assign $SUB $MERCHANT $HASH $SUB)"; exit 1; }
    ok "load-permiso" "asignado → '$MERCHANT' ($HASH) [antes: ${CUR:-ninguno}]"
    # El wizard FIJA el comercio del asesor en su cookie de sesión AL LOGUEAR: si la asignación cambió,
    # una sesión cacheada sigue entrando al comercio ANTERIOR — el deploy responde 302 al hash viejo y
    # la corrida "se va" por otro comercio (visto contra originaciones-stg el 2026-08-19: pediste dentix
    # y el front te devolvió a celurd). Se invalida el cache para que ESTA corrida loguee de nuevo y la
    # sesión nazca con la asignación nueva. La clave espeja a pkg/cognito.ts (SESSION_KEY): front del
    # ambiente cachea por target; front local (o una ruta) cachea como 'dev'.
    if [ "${CFE_FRONT:-}" = "ambiente" ]; then SESKEY="$TARGET"; else SESKEY="dev"; fi
    if [ -f ".auth/cognito-state.$SESKEY.json" ]; then
      rm -f ".auth/cognito-state.$SESKEY.json"
      echo "  ↻ sesión cacheada invalidada (cognito-state.$SESKEY.json): el comercio cambió — esta corrida loguea de nuevo"
    fi
  fi
fi

# ── ¿la sucursal que vamos a correr es la que el backend le da a ESTE asesor? ─────────────────────
# SÓLO LECTURA. El chequeo de arriba (`whois` contra el hash del catálogo) mira la BASE, que es un
# proxy: el wizard no usa `users.allied_branch_id`, usa lo que le devuelve el backend para el sub que
# está logueado. Por eso una corrida pudo imprimir «ya en 'pullman' (13874eb6) — sin write» y aterrizar
# en `ec977139` — y con OTRAS entidades que las anunciadas. Medido el 2026-09-15 contra qa.
# No falla la corrida: avisa. Quién arregla el desajuste (reasignar, borrar la sesión) lo decide quien
# corre — hay casos legítimos de correr contra la sucursal que el asesor ya tiene.
if [ "$PREBOOT" != 1 ] && [ "$ECOMMERCE" != 1 ] && [ "$SIN_ASESOR" != 1 ]; then
  CHK="$(node bin/dbops.ts sucursal-check "$HASH" "$SUB" 2>/dev/null)"
  COINCIDE="$(printf '%s' "$CHK" | json_pick '.coincide')"
  if [ "$COINCIDE" = "false" ]; then
    printf '%s' "$CHK" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{for(const l of (JSON.parse(s).aviso||[]))console.log("  "+l)}catch(e){}})'
  fi
fi

# ── scrub del cliente: borra el usuario del teléfono → register fresco → /personal-info ──
step "scrub-cliente"
if [ "$PREBOOT" = 1 ]; then
  ok "scrub-cliente" "n/a (preboot: no se toca la BD)"
else
# ⚠ UNA sola llamada, y de ahí se sacan los dos datos. La primera versión de esto llamaba a
# `scrubphone` dos veces —una por campo—: un borrado duplicado, y encima la segunda no encontraba
# nada porque la primera ya había borrado, así que el dato que venía a mostrar salía vacío.
SCRUB="$(I_KNOW_THIS_TOUCHES_SHARED_DEV=1 node bin/dbops.ts scrubphone "$BYPASS_PHONE" 2>/dev/null)"
DEL="$(printf '%s' "$SCRUB" | json_pick '.users_deleted')"
# Los FORMATOS en que estaba guardado el teléfono. Se muestran porque un formato inesperado es lo que
# escondió a un usuario del scrub durante meses (F-195): `+1` en un número colombiano.
FMT="$(printf '%s' "$SCRUB" | json_pick '.formatos_encontrados' | tr -d '[]"' | tr ',' ' ')"
ok "scrub-cliente" "${DEL:-0} borrado(s) ($BYPASS_PHONE${FMT:+ · guardado como $FMT} → temporal → personal-info)"

# ── y en LOCAL, además, las identidades que dejaron las corridas anteriores ───────────────────────
# El scrub de arriba limpia el teléfono de ESTA corrida, y con eso ESTA corrida arranca limpia. Lo que
# no cubre es la ACUMULACIÓN: medido el 2026-09-10, local tenía 1.296 usuarios del caminador y ~45 de
# `synthFill`, cada uno una trampa latente — el día que un teléfono o un documento se repita, la
# corrida nueva reusa esa identidad y el flujo se salta la pantalla de datos personales sin avisar.
# Eso es F-195 esperando, y ya pasó una vez.
#
# ⚠ SÓLO EN LOCAL, y el propio comando se niega si no: en la base compartida puede haber una corrida
# de otra persona en vuelo, y borrarle su usuario sintético a mitad le rompe la prueba sin que
# entienda por qué. Allá tampoco hace falta — eran 3, contra 1.296 acá.
if [ "$TARGET" = "local" ]; then
  IDS="$(node bin/dbops.ts scrub-sinteticos 2>/dev/null | json_pick '.users_deleted')"
  # `if` y no `[ … ] && …`: bajo `set -e` un test falso al final de un bloque aborta el script.
  if [ "${IDS:-0}" != "0" ]; then
    ok "scrub-sinteticos" "${IDS} sintético(s) de corridas anteriores (los registros reales abandonados quedan)"
  fi
fi
fi

# ── LO QUE HAY QUE TIPEAR, en una línea estable y machine-readable ────────────────────────────────
# Nace de un fallo real (2026-08-19): la corrida murió en el OTP porque se tipeó un teléfono que NO era
# el del bypass. El dato estaba en el log —en la línea del scrub— pero enterrado. Acá va explícito, con
# el OTP ya calculado (el bypass hace que el código sean los ÚLTIMOS 4 del teléfono; la firma usa 6).
# El prefijo `⌨ DATOS ` es CONTRATO con el panel, que lo parsea para armar los chips copiables: si lo
# cambiás, actualizá `panel/index.html` (parseDatos). El resto de la línea es para leer en terminal.
# ── EL CÓDIGO DE LA APP, generado como lo haría la app ────────────────────────────────────────────────
# Sólo en el canal del asesor, que es el único con la pantalla `/merchant/<hash>/codigo` («Usuario app»).
# Local lo siembra en el mock (`make harness-codes`); dev/qa/staging se lo piden al servicio de dev. El
# autorrelleno lo pone en esa pantalla (`E2E_CLIENT_CODE_APP`) y el panel lo muestra para copiar. Es
# opcional: si no se puede —otro país, sin mock, sin VPN— se avisa y la corrida sigue igual.
# `E2E_CLIENT_CODE_GEN=0` lo apaga; `E2E_CLIENT_CODE_LENDER_ID=<id>` elige la entidad del preaprobado.
CLIENT_CODE=""
if [ "$ECOMMERCE" != 1 ] && [ "$PREBOOT" != 1 ] && [ "$SIN_ASESOR" != 1 ] && [ "${E2E_CLIENT_CODE_GEN:-1}" != 0 ]; then
  CC_JSON="$(node bin/client-code.ts "$HASH" "${E2E_CLIENT_CODE_LENDER_ID:-}" 2>/dev/null || true)"
  CLIENT_CODE="$(printf '%s' "$CC_JSON" | json_pick '.code')"
  if [ -n "$CLIENT_CODE" ]; then
    export E2E_CLIENT_CODE_APP="$CLIENT_CODE"
    ok "codigo-app" "$CLIENT_CODE · $(printf '%s' "$CC_JSON" | json_pick '.lender') ($(printf '%s' "$CC_JSON" | json_pick '.lenderId')) — la única entidad que debe quedar en el listado"
    CC_NOTE="$(printf '%s' "$CC_JSON" | json_pick '.branchNote')"
    [ -n "$CC_NOTE" ] && echo "  ⚠ codigo-app    $CC_NOTE"
  else
    echo "  ⚠ codigo-app    sin código: $(printf '%s' "$CC_JSON" | json_pick '.skip')"
  fi
fi

if [ "$ECOMMERCE" != 1 ] && [ "$PREBOOT" != 1 ]; then
  echo "⌨ DATOS  telefono=$BYPASS_PHONE otp=${BYPASS_PHONE: -4} otpfirma=${BYPASS_PHONE: -6} cedula=${E2E_SYNTH_DOC:-(auto)} email=${E2E_SYNTH_EMAIL:-(auto)}${CLIENT_CODE:+ codigoapp=$CLIENT_CODE}"
fi

# ── wizard local (Vite) → DEV: reusar si está arriba; reiniciar solo si apuntaba a otro backend ──
step "frontend"
if [ "$REMOTE_FRONT" = 1 ] && [ "$PREBOOT" = 1 ]; then
  # front desplegado: no hay Vite que precalentar, y el preboot no tiene nada que hacer.
  ok "frontend" "n/a (preboot con front del ambiente: ${WIZ_BASE} no se levanta acá)"
  exit 0
fi
if [ "$REMOTE_FRONT" = 1 ]; then
  # front YA DESPLEGADO (staging): no se levanta Vite, no se toca el .env.local del wizard, y las
  # variables VITE_* no aplican — vienen del build remoto. Solo se comprueba que responda.
  FE_CODE="$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "$WIZ_BASE" 2>/dev/null || echo 000)"
  case "$FE_CODE" in
    000) ok "frontend" "✗ sin respuesta (${WIZ_BASE}) — ¿VPN / URL correcta?"; exit 1 ;;
    5*)  ok "frontend" "✗ HTTP $FE_CODE — el front de '${TARGET}' está roto (${WIZ_BASE})"; exit 1 ;;
    # 302 es lo NORMAL: sin sesión, el front redirige al login de Cognito. No es una falla.
    *)   ok "frontend" "remoto (${WIZ_BASE} · ${TARGET}) — HTTP $FE_CODE, no se levanta wizard local" ;;
  esac
else
UP=0; curl -s -o /dev/null --max-time 3 http://localhost:5174 2>/dev/null && UP=1
# VITE_API_URL del wizard: E2E_API_BASE_URL de la cadena del target, sin /api; fallback al host dev.
# E2E_MOCK_URL PISA si está: es el override explícito para apuntar el wizard a un backend mockeado.
WIZ_API="$(envget E2E_MOCK_URL)"; [ -n "$WIZ_API" ] || WIZ_API="$(envget E2E_API_BASE_URL)"
WIZ_API="${WIZ_API%/api}"; WIZ_API="${WIZ_API%/}"; [ -n "$WIZ_API" ] || WIZ_API="http://legacy-backend.inertia-develop"
# VITE_ONBOARDING_FORM_SERVICE (flujo dinámico): del .env del wizard, fallback a dev. Se pasa explícito porque
# el .env.local trae un valor FAKE que Vite hot-reloadea → 404 del schema.
# (este SÍ es un grep: lee el `.env` del wizard, que es otro repo y no está en la cadena. `|| true` por F-59.)
FORMS="$( { grep -E '^VITE_ONBOARDING_FORM_SERVICE=' "$WIZARD/.env" 2>/dev/null || true; } | head -1 | sed -E 's/^[^=]*=//; s/[[:space:]]*#.*$//; s/^["'\'']//; s/["'\'']$//' | tr -d '[:space:]')"
[ -n "$FORMS" ] || FORMS="http://onboarding-forms-service.inertia-develop:8092/v1"
# En LOCAL el host de dev necesita VPN → usamos el mock (bin/mock-forms). Ver findings F-41.
[ "$TARGET" = "local" ] && FORMS="http://localhost:${MOCK_FORMS_PORT:-8101}/v1"
# VITE_FORM_SERVICE_BASE_URL (form dinámico G2 "backend-driven", ruta additional-info de Credifamilia): el MS Go
# `form-service`. El harness NO lo pasaba → el loader fetcheaba a `undefined/v1/...` y el form no renderizaba.
# Se fetchea SSR (loader del wizard) → lo pega el Node, que alcanza .inertia-develop. OJO: el `mock-forms` de
# arriba es de OTRO servicio (onboarding-forms-service, el RD) y NO cubre /v1/dynamic-form ni /v1/field-options.
# ⚠ EN LOCAL VA AL MOCK (`bin/mock-forms-g2`, :8109) Y NO A DEV, y no es una preferencia: guardar un
# formulario ESCRIBE, y el `user_request_id` de una corrida local es en dev la solicitud de otra
# persona — apuntando a dev, recorrer el formulario del vehículo de BCP «en local» le colgaba un
# vehículo sintético a una solicitud ajena de la base COMPARTIDA de dev+staging. Sale de la cadena
# (`.env.local` lo trae), y el fallback a dev queda sólo para los targets desplegados.
FORMSVC="$(envget E2E_FORM_SERVICE_BASE_URL)"
[ -n "$FORMSVC" ] || FORMSVC="http://form-service.inertia-develop:8082"
# VITE_PREAPPROVALS_ENDPOINT: MS de pre-aprobaciones (rt≠STANDARD; el loader de /lenders hace POST server-to-server).
# Por la CADENA (envget) y no `${E2E_REAL_PREAPPROVALS:-0}` pelado: así vive en `.env.<target>` y cada
# ambiente decide, en vez de depender de que alguien exporte la variable a mano en esa shell.
if [ "$(envget E2E_REAL_PREAPPROVALS 0)" = 1 ]; then
  PREAPPROVALS="$(envget E2E_PREAPPROVALS_ENDPOINT)"
  [ -n "$PREAPPROVALS" ] || PREAPPROVALS="http://pre-approvals-service.inertia-develop:8082/v1/preapprovals/check"
  log "pre-aprobaciones REALES (MS dev, lento) [E2E_REAL_PREAPPROVALS=1]"
else
  "$(dirname "$0")/mock-preapprovals" start >/dev/null 2>&1 || true
  PREAPPROVALS="http://localhost:${MOCK_PA_PORT:-8095}/v1/preapprovals/check"
  log "pre-aprobaciones MOCK local (:${MOCK_PA_PORT:-8095}, todas pre-aprobadas con cupo)"
fi

# Mock de PAYVALIDA: lo dispara el lender rt=1 (Bancolombia #8, `action` = App\Actions\Lenders\Payvalida).
# Sin PAYVALIDA_HOST en legacy-backend/.env la URL sale sin host y el flujo muere con
# "No pudimos procesar tu solicitud". El backend debe apuntar a este puerto (ver README §8).
# Solo en LOCAL: contra dev el proveedor real está configurado.
if [ "$TARGET" = "local" ]; then
  MOCK_PV_RETURN_URL="${E2E_RETURN_URL:-}" "$(dirname "$0")/mock-payvalida" start >/dev/null 2>&1 || true
  "$(dirname "$0")/mock-mdm" start >/dev/null 2>&1 || true
  "$(dirname "$0")/mock-lenders" start >/dev/null 2>&1 || true
  "$(dirname "$0")/mock-forms" start >/dev/null 2>&1 || true
  # Ábaco: lo pide el flujo de RENTING (lenders con product='renting', ej. Motai R) después de elegir
  # entidad. Sin él, ABACO_HOST apunta al propio backend y el init muere con ABAC2004.
  "$(dirname "$0")/mock-abaco" start >/dev/null 2>&1 || true
  # Financial-health: el MS que consume la pantalla del ASESOR (financial-profile, decisión de Motai
  # renting/rto). Sin él, su loader muere con `fetch failed` (F-70). Lee la BD local (datos reales).
  "$(dirname "$0")/mock-financial-health" start >/dev/null 2>&1 || true
  # API Fondos de Corbeta: el servicio del COMERCIO que emite el PIN del código de compra en caja. Lo
  # necesita el canal QR para llegar al final (purchase-code/generate). Es 100% externo — sin mock ese
  # tramo no corre en local y no se puede caracterizar (hoy tiene cero tests). Apuntá el backend:
  #   CORBETA_HOST=http://host.docker.internal:8103
  "$(dirname "$0")/mock-corbeta" start >/dev/null 2>&1 || true
  # API de Bancolombia (BNPL 68 + Consumo 100). En local BANCOLOMBIA_HOST es `https://bancolombia.fake`
  # (placeholder a propósito): sin este mock todo el canal QR muere en el DNS. Apuntá el backend:
  #   BANCOLOMBIA_HOST=http://host.docker.internal:8104
  #   BANCOLOMBIA_AUTH_HOST=http://host.docker.internal:8104
  "$(dirname "$0")/mock-bancolombia" start >/dev/null 2>&1 || true
  # form-service (el «G2»): el formulario del VEHÍCULO de BCP. Se levanta SIEMPRE en local aunque el
  # comercio no sea peruano — es barato, y la alternativa (caer al host de dev) escribe en la base
  # compartida sin avisar.
  "$(dirname "$0")/mock-forms-g2" start >/dev/null 2>&1 || true
  log "mocks locales: payvalida :${MOCK_PV_PORT:-8097} · mdm/IMEI :${MOCK_MDM_PORT:-8098} · entidades :${MOCK_LENDERS_PORT:-8099} · forms :${MOCK_FORMS_PORT:-8101} · form-service/G2 :${MOCK_FORMS_G2_PORT:-8109} · ábaco :${MOCK_ABACO_PORT:-8102} · fin-health :${MOCK_FINHEALTH_PORT:-4000} · corbeta/fondos :${MOCK_CORBETA_PORT:-8103} · bancolombia :${MOCK_BC_PORT:-8104}"
fi

# ── health-check del backend ANTES del cold-boot ──────────────────────────────────────────────
# Un 5xx del backend tumba TODO el flujo: el loader del wizard (react-router SSR) rechaza una promesa
# sin catch y en Node 25 un UnhandledPromiseRejection MATA el dev server → :5174 muere y el callback de
# Cognito cae en ERR_CONNECTION_REFUSED. Cortamos acá (1 curl barato) en vez de perder ~3 min booteando
# un wizard condenado. Canario = el mismo endpoint allied que consume el loader (ejercita el boot de
# Laravel completo). 4xx = Laravel vivo (ruta/hash), seguimos.
step "backend"
BE_URL="${WIZ_API}/api/loans/allied/${HASH}"
BE_CODE="$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "$BE_URL" 2>/dev/null)" || true
[ -n "$BE_CODE" ] || BE_CODE=000
case "$BE_CODE" in
  5*)
    ok "backend" "✗ HTTP $BE_CODE — backend '${TARGET}' roto (${WIZ_API})"
    if [ "$TARGET" = "local" ]; then
      echo "    5xx en todo → cache/autoload stale de Laravel (típico tras cambiar de rama). Fix en el sail de legacy-backend:"
      echo "      ./vendor/bin/sail composer dump-autoload -o && ./vendor/bin/sail artisan optimize:clear && ./vendor/bin/sail artisan package:discover"
    else
      echo "    5xx del backend '${TARGET}' → revisá logs/deploy antes de reintentar."
    fi
    exit 1 ;;
  000)
    ok "backend" "✗ sin respuesta (${WIZ_API})"
    if [ "$TARGET" = "local" ]; then
      echo "    sail abajo → levantá el stack de legacy-backend: ./vendor/bin/sail up -d"
    else
      echo "    ${WIZ_API} inalcanzable → ¿VPN conectada?"
    fi
    exit 1 ;;
  *)
    ok "backend" "HTTP $BE_CODE — vivo (${WIZ_API} · ${TARGET})" ;;
esac

# ⚠ «frontend reusado» tiene que ser una MEDICIÓN, no una creencia. El 2026-09-14 esta línea imprimió
# «reusado (:5174 → http://localhost · local)» y el wizard de verdad (a) servía el bundle de SERVIDOR de la
# rama del día anterior y (b) tras un reinicio a mano leía su .env y pegaba contra dev con `/api` doblado
# (502 mudo). Ninguna de las dos se veía. Cuatro comprobaciones antes de reusar, en este orden:
WANT="${WIZ_API}|${PREAPPROVALS}"
MARKER=/tmp/asesor-wizard.api
if [ "$UP" = 1 ] && [ "$FRESH" = 0 ]; then
  LISTEN_PID="$(lsof -ti:5174 2>/dev/null | head -1)"
  # (1) ¿ES EL MISMO PROCESO que lanzó bin/advisor? El marker guarda dos líneas: el PID que quedó
  #     escuchando y el WANT con el que se lanzó. Sólo vale si el PID coincide con el que escucha HOY:
  #     el formato viejo (una línea) describía el proceso lanzado, no el que corre, y por eso mintió.
  CUR_API=""
  # El panel sólo puede mostrar SSR si este proceso es el que dejó `bin/advisor`.
  # Un Vite levantado a mano puede tener el mismo backend y pasar las comprobaciones
  # de abajo, pero escribe su stdout en otra terminal: el panel queda siguiendo un
  # /tmp/asesor-wizard.log viejo y parece que no hay trazas. Conservamos la
  # comprobación de ENV para explicar el motivo, pero no reutilizamos ese proceso.
  OWNED_BY_ASESOR=0
  if [ -f "$MARKER" ] && [ -n "$LISTEN_PID" ] && [ "$(sed -n 1p "$MARKER" 2>/dev/null || true)" = "$LISTEN_PID" ]; then
    CUR_API="$(sed -n 2p "$MARKER" 2>/dev/null || true)"
    OWNED_BY_ASESOR=1
  fi
  # (2) Si no, el ENV del proceso: VITE_API_URL sólo está ahí si alguien lo lanzó con la variable puesta.
  if [ -z "$CUR_API" ]; then
    for p in $LISTEN_PID $(pgrep -f 'pnpm dev' 2>/dev/null); do
      # `|| true` en cada tubería: bajo `set -eo pipefail` un grep sin match tumbaba el script entero acá.
      v="$(ps eww -p "$p" 2>/dev/null | tr ' ' '\n' | grep -E '^VITE_API_URL=' | head -1 | sed 's/^VITE_API_URL=//' || true)"
      pa="$(ps eww -p "$p" 2>/dev/null | tr ' ' '\n' | grep -E '^VITE_PREAPPROVALS_ENDPOINT=' | head -1 | sed 's/^VITE_PREAPPROVALS_ENDPOINT=//' || true)"
      [ -n "$v" ] && { CUR_API="${v%/}|${pa:-$PREAPPROVALS}"; break; }
    done
  fi
  # (3) Si tampoco, lo lanzaron pelado y Vite leyó su .env(.local): ESO es lo que sirve, no lo que pedís.
  if [ -z "$CUR_API" ]; then
    for f in "$WIZARD/.env.local" "$WIZARD/.env"; do
      v="$(grep -E '^VITE_API_URL=' "$f" 2>/dev/null | head -1 | sed 's/^VITE_API_URL=//; s/["'"'"']//g' || true)"
      if [ -n "$v" ]; then
        v="${v%/}"; v="${v%/api}"; CUR_API="${v}|${PREAPPROVALS}"
        log "el wizard en :5174 no lo lanzó bin/advisor: su backend sale de ${f##*/} (${v})"
        break
      fi
    done
  fi
  CUR_API="${CUR_API%/}"
  if [ -n "$CUR_API" ] && [ "$CUR_API" != "$WANT" ]; then
    log "el wizard en :5174 apunta a ${CUR_API%%|*} pero pedís ${WIZ_API} → reinicio limpio"; FRESH=1
  elif [ -z "$CUR_API" ]; then
    log "no pude confirmar el backend del wizard en :5174 → reinicio limpio"; FRESH=1
  elif [ "$OWNED_BY_ASESOR" = 0 ]; then
    log "el wizard en :5174 no lo lanzó bin/advisor → reinicio limpio para que el panel capture su SSR"; FRESH=1
  fi
  # (4) ¿ES MÁS VIEJO QUE LA RAMA? Un dev server que arrancó ANTES del último movimiento de HEAD del
  #     monorepo puede seguir sirviendo el bundle de SERVIDOR de la rama anterior aunque las rutas
  #     nuevas ya carguen: medido el 2026-09-14 (arrancado el 13 a las 10:11, la rama cambió el 14 a las
  #     14:28, y el SSR seguía pintando testids que no existían en el fuente). Vite no avisa.
  if [ "$FRESH" = 0 ] && [ -n "$LISTEN_PID" ] && git -C "$FRONT" rev-parse --git-dir >/dev/null 2>&1; then
    PROC_T="$(ps -o lstart= -p "$LISTEN_PID" 2>/dev/null | sed 's/^ *//; s/  */ /g' || true)"
    PROC_S="$(date -j -f '%a %b %d %T %Y' "$PROC_T" +%s 2>/dev/null || true)"
    HEAD_S="$(git -C "$FRONT" reflog -1 --format=%ct 2>/dev/null || true)"
    if [ -n "$PROC_S" ] && [ -n "$HEAD_S" ] && [ "$PROC_S" -lt "$HEAD_S" ]; then
      log "el wizard en :5174 arrancó el $(date -r "$PROC_S" '+%d/%m %H:%M') y la rama del monorepo se movió después ($(date -r "$HEAD_S" '+%d/%m %H:%M') → $(git -C "$FRONT" rev-parse --abbrev-ref HEAD 2>/dev/null)): puede servir el bundle de servidor viejo → reinicio limpio"; FRESH=1
    fi
  fi
fi
if [ "$UP" = 1 ] && [ "$FRESH" = 0 ]; then
  ok "frontend" "reusado (:5174 pid ${LISTEN_PID:-?} → ${WIZ_API} · ${TARGET} · backend y antigüedad verificados)"
else
  if [ "$UP" = 1 ]; then
    log "reinicio el wizard en :5174 (limpio contra ${TARGET})…"
    lsof -ti:5174 2>/dev/null | xargs kill -9 2>/dev/null || true
    for _ in $(seq 1 10); do curl -s -o /dev/null --max-time 1 http://localhost:5174 2>/dev/null || break; done
  fi
  MOVED=0
  # return 0: trap EXIT bajo `set -e` — si la última expresión da !=0 el script saldría con 1 pese al exit 0.
  restore_envlocal() { [ "$MOVED" = 1 ] && mv -f "$WIZARD/.env.local.asesor-bak" "$WIZARD/.env.local" 2>/dev/null && { echo "    .env.local del wizard restaurado"; MOVED=0; }; return 0; }
  trap restore_envlocal EXIT INT TERM
  if [ -f "$WIZARD/.env" ] && [ -f "$WIZARD/.env.local" ]; then
    mv "$WIZARD/.env.local" "$WIZARD/.env.local.asesor-bak"; MOVED=1
  fi
  printf '%s\n%s' "" "$WANT" > "$MARKER" 2>/dev/null || true   # el PID se completa cuando levante
  # El directorio ANTES de esperar: si no existe, el `cd` del subshell falla, `pnpm dev` no corre y el
  # bucle de abajo igual espera 480s. Cortar acá con el path a la vista ahorra los 8 minutos.
  if [ ! -d "$WIZARD" ]; then
    ok "frontend" "✗ no existe el directorio del wizard: $WIZARD"
    echo "    revisá CFE_FRONT_PATH (o CFE_FRONT si le pasás una ruta). CFE_FRONT actual: '${CFE_FRONT:-}'"
    exit 1
  fi
  # El log se trunca ANTES de lanzar: si el arranque falla sin llegar a escribir, el `tail` de abajo
  # mostraba el log de la corrida ANTERIOR y el error viejo se leía como el actual (pasó: un
  # `Cannot find module` ya resuelto seguía apareciendo y mandó a buscar donde no era).
  : > /tmp/asesor-wizard.log
  # < /dev/null + nohup: react-router dev lee stdin; sin esto crashea al cerrarse el pipe. STREAM_TIMEOUT_MS:
  # el loader de /lenders (pre-aprobación sincrónica del MS por VPN) suele pasar de los 45s default → lo subimos.
  # ⚠ El `> /dev/null 2>&1` del SUBSHELL (afuera del paréntesis) no es cosmética: sin él, el subshell
  # que lanza el wizard HEREDA el stdout/stderr de la corrida y queda vivo mientras Vite corra. Como
  # `child.on('close')` de Node espera a que los streams cierren —no sólo a que el proceso muera—, el
  # panel nunca se enteraba de que la corrida terminó: decía "corriendo" para siempre y se perdía el
  # post-mortem de BD. Medido el 2026-08-19 con `sample`: el proceso colgado era el subshell (cwd =
  # apps/loan-request-wizard), no el script, que ya había salido. El redirect de adentro sigue siendo
  # para el LOG del wizard; este de afuera es para soltar el pipe de la corrida.
  # Forzamos IPv4 de loopback: Vite puede quedar sólo en ::1 y Chrome resuelve localhost a 127.0.0.1,
  # caso en el que el launcher decía “arriba” pero el wizard no se podía abrir desde el navegador.
  ( cd "$WIZARD" && nohup env VITE_API_URL="$WIZ_API" VITE_ONBOARDING_FORM_SERVICE="$FORMS" VITE_FORM_SERVICE_BASE_URL="$FORMSVC" VITE_PREAPPROVALS_ENDPOINT="$PREAPPROVALS" CALLBACK_URL="http://localhost:5174/auth/callback" STREAM_TIMEOUT_MS="${E2E_STREAM_TIMEOUT_MS:-180000}" pnpm dev --host 127.0.0.1 < /dev/null > /tmp/asesor-wizard.log 2>&1 & ) > /dev/null 2>&1
  echo "    cold-boot del wizard (pnpm dev/Vite, puede tardar 1-3 min la 1ª vez)…"
  boot=0
  for i in $(seq 1 240); do
    curl -s -o /dev/null --max-time 2 http://localhost:5174 2>/dev/null && { boot=$((i * 2)); break; }
    [ $((i % 10)) -eq 0 ] && echo "    … sigue compilando (~$((i * 2))s)"
  done
  if [ "$boot" = 0 ]; then
    ok "frontend" "✗ no levantó (ver /tmp/asesor-wizard.log)"; tail -15 /tmp/asesor-wizard.log 2>/dev/null
    restore_envlocal; exit 1
  fi
  # NO restaurar el .env.local acá (Vite hot-reloadearía sus valores fake y rompe el flujo). El trap EXIT lo restaura al final.
  # El marker queda atado al PID que escucha: así la próxima corrida sabe si el proceso sigue siendo éste
  # o alguien lo reinició a mano (ver las cuatro comprobaciones de arriba).
  printf '%s\n%s' "$(lsof -ti:5174 2>/dev/null | head -1)" "$WANT" > "$MARKER" 2>/dev/null || true
  ok "frontend" "arriba (:5174 → ${TARGET} · ${WIZ_API} · forms ${FORMS##*//} · boot ~${boot}s)"
fi
fi

# ── PREBOOT: el wizard ya está tibio; salir sin correr el spec ────────────────────────────────────
if [ "$PREBOOT" = 1 ]; then
  # ⚠ NO restaurar `.env.local` del wizard: Vite lo hot-recargaría y el wizard que acabamos de
  # precalentar quedaría apuntando a los valores de ese archivo — o sea, desarmado. Se deja aparcado
  # en `.env.local.asesor-bak`, que es EXACTAMENTE lo que ya pasa cuando una corrida reusa el wizard
  # (el trap sólo vive en la rama que bootea). La corrida real que venga lo reusa por el marcador.
  MOVED=0
  echo "✅ wizard precalentado (:5174 → ${TARGET} · ${WIZ_API}) — la próxima corrida lo reusa"
  [ -f "$WIZARD/.env.local.asesor-bak" ] && echo "    (.env.local del wizard aparcado como .env.local.asesor-bak — lo restaura la corrida que reinicie el wizard)"
  exit 0
fi

# ── correr el spec (dev/guided.spec.ts: GUIADO si E2E_GUIDED=1, MANUAL si 0) ──
if [ "$GUIDED" = 1 ]; then
  log "GUIADO '$MERCHANT' (${ENTRY}) → manejá monto→tel→OTP; en /lenders elegís y el demo sigue"
else
  log "MANUAL '$MERCHANT' (${ENTRY}) → entra y queda en MONTO; el browser queda abierto (manejás vos)"
fi
set +e
npx playwright test dev/guided.spec.ts --workers=1 --headed --reporter=line
code=$?
set -e
if [ "$code" = 130 ] || [ "$code" = 143 ]; then
  echo "⏹  interrumpido (Ctrl-C)."; exit 0
elif [ "$code" != 0 ]; then
  echo "✗ falló (code $code) — revisá .auth/*.png"; exit "$code"
fi
if [ "$ECOMMERCE" = 1 ]; then
  echo "✅ '$MERCHANT' OK contra ${TARGET} · checkout: ${WIZ_BASE}/ecommerce/$HASH/checkout"
else
  # La URL "a mano" depende del CANAL: el tronco `/merchant/{hash}/solicitar` no existe para el QR, y
  # ofrecerla mandaba a una pantalla que no es la de este recorrido.
  if [ "$ENTRY" = "qr" ]; then
    echo "✅ '$MERCHANT' OK contra ${TARGET} · a mano: ${WIZ_BASE}/bancolombia/self-service/$HASH/solicitar"
  elif [ "$ENTRY" = "self-service" ]; then
    echo "✅ '$MERCHANT' OK contra ${TARGET} · a mano: ${WIZ_BASE}/self-service/$HASH/solicitar"
  else
    echo "✅ '$MERCHANT' OK contra ${TARGET} · a mano: ${WIZ_BASE}/merchant/$HASH/solicitar"
  fi
fi
exit 0
