#!/usr/bin/env bash
# seed-code — deja un código de preaprobado listo para probar la pantalla del asesor en LOCAL.
#
# El código lo resuelve un servicio externo que en local no existe: lo reemplaza `mock-codes`
# (`make harness-codes`, :8111). Qué comercio, qué entidad y qué cliente lo resuelve
# `pkg/client-code.ts` —el mismo que usa `bin/advisor` al lanzar—; esto sólo traduce el slug y lo
# imprime para leer. El backend verifica las tres cosas contra la base, así que un código con datos
# inventados se rechaza aunque el mock diga que existe.
#
#   bin/seed-code <hash|slug> [codigo] [lender_id]
#
# Ejemplos:
#   bin/seed-code 13874eb6             # código inventado del formato vigente (AA0000)
#   bin/seed-code pullman AB1234 77    # slug de .flows.json, código y entidad explícitos
set -euo pipefail

E2E="${CFE_E2E:-$(cd "$(dirname "$0")/.." && pwd)}"
WHO="${1:-}"; CODE="${2:-}"; LENDER="${3:-}"
[ -n "$WHO" ] || { echo "uso: bin/seed-code <hash|slug> [codigo] [lender_id]"; exit 2; }

# Un slug de .flows.json se traduce a hash; un hash se usa tal cual.
HASH="$WHO"
if [ -f "$E2E/.flows.json" ]; then
  FROM_SLUG="$(node -e "
    const f=require('$E2E/.flows.json');
    const m=(f.merchants||{})['$WHO'];
    process.stdout.write(m?.branch_hash || '');
  " 2>/dev/null || true)"
  [ -n "$FROM_SLUG" ] && HASH="$FROM_SLUG"
fi

cd "$E2E"
OUT="$(E2E_TARGET=local node bin/client-code.ts "$HASH" "$LENDER" "$CODE")"
node -e '
  const r = JSON.parse(process.argv[1]);
  if (r.skip) { console.log("✗ " + r.skip); process.exit(1); }
  console.log(`✔ código ${r.code} sembrado`);
  console.log(`   comercio  ${r.merchant} (allied ${r.alliedId} · sucursal ${r.branchId})`);
  console.log(`   entidad   ${r.lender} (${r.lenderId})`);
  console.log(`   usuario   ${r.userId}`);
  if (r.branchNote) console.log(`   ⚠ ${r.branchNote}`);
' "$OUT" "$HASH"
