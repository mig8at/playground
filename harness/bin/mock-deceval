#!/usr/bin/env bash
# Mock de DECEVAL — el depósito que registra y firma el PAGARÉ desmaterializado de Credifamilia (rt=4).
# Sin él la autorización muere en «Error al generar pagaré Deceval» y la solicitud queda en estado 28.
#
# Apuntá el backend en legacy-backend/.env (host.docker.internal, NO localhost — corre en Docker):
#   DECEVAL_SOAP_HOST=http://host.docker.internal:8106  (idem DECEVAL_NOTE_HOST)
#
# ⚠ NO prueba la firma: un pagaré desmaterializado vale porque no se puede simular. Prueba la orquestación.
#
# uso: bin/mock-deceval [start|stop|status|logs]
#   env: MOCK_DECEVAL_PORT (8106) · MOCK_DECEVAL_FAIL=1 → camino de rechazo
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${MOCK_DECEVAL_PORT:-8106}"
LOG=/tmp/mock-deceval.log

up() { curl -s -o /dev/null --max-time 2 "http://localhost:$PORT" 2>/dev/null; }

case "${1:-start}" in
  start)
    WANT_FAIL="${MOCK_DECEVAL_FAIL:-0}"
    if up; then
      CUR="$(curl -s --max-time 2 "http://localhost:$PORT" 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.stdout.write(JSON.parse(s).fail?"1":"0")}catch{process.stdout.write("0")}})')"
      if [ "${CUR:-0}" = "$WANT_FAIL" ]; then echo "✓ mock-deceval ya arriba (:$PORT)"; exit 0; fi
      echo "↻ reinicio mock-deceval (modo fallo: ${CUR:-0} → $WANT_FAIL)"
      lsof -ti:"$PORT" 2>/dev/null | xargs kill -9 2>/dev/null || true
      for _ in $(seq 1 10); do up || break; sleep 0.2; done
    fi
    rm -f "$LOG"
    nohup env MOCK_DECEVAL_PORT="$PORT" MOCK_DECEVAL_FAIL="$WANT_FAIL" \
      node "$DIR/mock-deceval/server.mjs" < /dev/null > "$LOG" 2>&1 &
    for _ in $(seq 1 25); do up && { echo "✓ mock-deceval :$PORT"; exit 0; }; sleep 0.3; done
    echo "✗ no levantó"; tail -8 "$LOG" 2>/dev/null; exit 1;;
  stop)
    lsof -ti:"$PORT" 2>/dev/null | xargs kill -9 2>/dev/null && echo "⏹ detenido (:$PORT)" || echo "no estaba corriendo";;
  status)
    if up; then curl -s --max-time 2 "http://localhost:$PORT" 2>/dev/null; echo ""; else echo "○ off (:$PORT)"; fi;;
  logs)
    tail -n "${2:-40}" "$LOG" 2>/dev/null || echo "(sin log)";;
  *)
    echo "uso: bin/mock-deceval [start|stop|status|logs]";;
esac
