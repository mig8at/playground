# ⚠ Las variables de BD llevan el prefijo `E2E_DB_` A PROPÓSITO — no lo saques.
#   Sin prefijo se llamarían `DB_HOST` y `DB_PORT`, que son EXACTAMENTE los nombres que lee Laravel.
#   Un `set -a; . este-archivo` en la shell dejaría a cualquier comando de artisan de legacy-backend
#   apuntando a esta base. `server/main.go` acepta los dos nombres (ver `alias`), así que el prefijo
#   no cuesta nada y quita el choque.

# trazador · qa = backend legacy-backend-qa (rama `qa`, workflow main-qa.yaml) · front originaciones-qa
#
# ⚠ qa NO es staging: son dos servicios distintos (staging es legacy-backend-stg, rama `staging`). Lo que
# sí comparten los tres —dev, qa y staging— es la BD y el stack de Loki `creditopdev`.

# ─── Loki · MISMO stack y MISMAS credenciales que .env.dev ────────────────────────────────────────
LOKI_URL=https://logs-prod-036.grafana.net
LOKI_USER=1339770
LOKI_TOKEN=glc_...
# Lo que separa qa de dev NO es `environment` (los dos PHP loguean `development`) sino `service_name`.
# MEDIDO el 2026-09-23: 25 GET a /api/loans/allied/a8221e67 contra cada backend desplegado, y cada
# ráfaga cayó entera en UN stream — legacy-backend-qa → `CreditopDev` · legacy-backend (dev) →
# `legacy-backend`. Lo pone un secreto del despliegue (GRAFANA_TEMPO_SERVICE_NAME), no el repo.
# ⚠ NO filtra: una solicitud puede pasar por los dos backends (la 502690, de qa, tiene 18 líneas de
# dev). La traza dice cuántas líneas sirvió cada uno. Para volver a medirlo, ver trazador/README.md.
LOKI_SERVICE=CreditopDev
# Esto SÍ filtra, y lo que deja afuera son las máquinas de desarrollo (`local`, `testing`), no dev.
LOKI_ENV=development|develop

# ─── BD · la RDS COMPARTIDA con dev y staging (es la misma base) ──────────────────────────────────
# ⚠ Si rotan las credenciales de dev, actualizá dev, staging y qa.
E2E_DB_HOST=inertia-development.cfya8a0qoudi.us-east-2.rds.amazonaws.com
E2E_DB_PORT=3306
E2E_DB_NAME=creditop
E2E_DB_USER=admin
E2E_DB_PASS=

# ─── PostHog · qué VIO el cliente en el navegador ─────────────────────────────────────────────────
# UN solo proyecto (238530) para todos los ambientes: el token es el MISMO de .env.prod y lo que cambia
# es el filtro. ⚠ El front de qa escribe `staging` (igual que el de staging: no hay valor `qa`), así
# que este filtro separa de prod —que comparte ids de solicitud con qa— pero NO de staging.
POSTHOG_TOKEN=phx_...
POSTHOG_PROJECT=238530
POSTHOG_ENV=staging
POSTHOG_API=
