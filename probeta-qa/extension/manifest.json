{
  "manifest_version": 3,
  "name": "Probeta-qa · CreditOp",
  "version": "0.1.0",
  "description": "Probeta-qa: pruebas a mano del wizard en qa. Persona nueva, centrales dictadas al mock de qa, OTP, rellenar y el recorrido, sin servidor. Con el servidor de Probeta (opcional, en ⚙) suma la base de la solicitud y aprobar la identidad.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.dev.creditop.com/*",
    "https://9b6r8ticg0.execute-api.us-east-2.amazonaws.com/*",
    "http://otp-service.inertia-develop:8083/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Probeta-qa",
    "default_icon": {
      "16": "icons/probeta-16.png",
      "32": "icons/probeta-32.png",
      "48": "icons/probeta-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dev.creditop.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/probeta-16.png",
    "32": "icons/probeta-32.png",
    "48": "icons/probeta-48.png",
    "128": "icons/probeta-128.png"
  }
}
