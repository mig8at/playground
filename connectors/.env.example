# connectors/.env.<target> — las credenciales de los conectores, UN archivo por ambiente
# (local · dev · qa · staging · prod). Fuera de git: copiá esta plantilla a .env.<target> y completá.
# Las variables del proceso ganan sobre el archivo. Qué conector lee qué: connectors/<conector>/.

# ── sql ─────────────────────────────────────────────────────────────────────────────────────────────
# Con E2E_DB_HOST se usa MySQL directo (local · dev · qa · staging). Son los mismos nombres del harness.
# ⚠ El prefijo E2E_DB_ va A PROPÓSITO: DB_HOST y DB_PORT son los nombres que lee Laravel, y un
#   `set -a; . este-archivo` dejaría cualquier `artisan` apuntando a esta base. Por eso el conector NO
#   lee DB_HOST ni del archivo ni del proceso.
# ⚠ qa y staging leen la MISMA base que dev: el resultado dice qué host contestó.
E2E_DB_HOST=
E2E_DB_PORT=3306
E2E_DB_NAME=
E2E_DB_USER=
E2E_DB_PASS=
# Sin E2E_DB_HOST se usa Redash: es el camino de prod, donde no hay acceso directo y cada consulta queda
# auditada a nombre del token. Pide la VPN de prod (el balanceador es interno).
REDASH_URL=
REDASH_TOKEN=
# 1 = «Live» (rds_mysql) de producción, que es el default
REDASH_DATA_SOURCE_ID=
# la zona en que Redash devuelve los datetime (default America/Bogota)
REDASH_TZ=

# ── logs ────────────────────────────────────────────────────────────────────────────────────────────
# local → el Loki de esta máquina (harness/bin/loki-local), sin credenciales ·
# dev · qa · staging → el stack creditopdev · prod → el stack creditop. Se aceptan los GRAFANA_LOKI_* de
# legacy-backend. Los dos stacks viven en la misma región: misma URL (logs-prod-036) y mismo token, y lo que
# cambia es LOKI_USER, que es POR STACK (creditop 1339721 · creditopdev 1339770).
LOKI_URL=
# el ID NUMÉRICO de la instancia de logs (6-7 dígitos): no el org del token, ni el slug, ni un email. Sin él,
# Grafana Cloud rechaza con `legacy auth cannot be upgraded`, que engaña porque suena a URL equivocada.
LOKI_USER=
# el glc_ de la access policy, con el scope logs:read
LOKI_TOKEN=
# sólo un Loki self-hosted detrás de un gateway lo necesita
LOKI_TENANT=
# SÍ filtra la etiqueta `environment` (alternativa de regex). En creditopdev los PHP de dev y de qa
# loguean los dos `development`: esto deja afuera las máquinas de desarrollo, no separa dev de qa.
LOKI_ENV=
# el service_name del monolito de este ambiente (dev → legacy-backend, qa → CreditopDev). NO filtra: sirve
# para decir qué backend sirvió cada línea.
LOKI_SERVICE=

# ── events ──────────────────────────────────────────────────────────────────────────────────────────
# UN solo proyecto para todos los ambientes (238530 «Loan Request»), separados por properties.environment:
# qa y staging escriben `staging`, prod `production`. local y dev NO escriben (el conector lo dice).
# La API de LECTURA (us.posthog.com), no la de ingesta (us.i.posthog.com): se corrige sola si pegás la otra.
POSTHOG_API=
# una PERSONAL API KEY (phx_) con query:read. ⚠ NO el phc_ del snippet del front: es de escritura y da 401.
POSTHOG_TOKEN=
POSTHOG_PROJECT=238530
POSTHOG_ENV=

# ═══ connectors/.env — los servicios SIN ambiente ═══════════════════════════════════════════════════
# Estas claves NO van en .env.<target>: una sola cuenta sirve para todos los ambientes, y viven en
# connectors/.env (también fuera de git).

# ── gemini ──────────────────────────────────────────────────────────────────────────────────────────
# una llave de AI Studio (empieza con AIza): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_PASOS=12

# ── atlassian (Jira y Confluence) ───────────────────────────────────────────────────────────────────
# Mismo sitio, misma cuenta y UN token para las dos partes. ⚠ Confluence no contesta 401 con el token
# vencido sino 403 o 404: el conector lo diagnostica preguntándole a Jira.
ATLASSIAN_SITE=https://creditop.atlassian.net
ATLASSIAN_EMAIL=
# https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=

# ── slack ──────────────────────────────────────────────────────────────────────────────────────────
# Bot token (xoxb-) de la Slack App: lo usan `pg slack` (y su MCP) y la lectura de #tech-ops del trazador.
# https://api.slack.com/apps → tu app → OAuth & Permissions → Install to Workspace.
SLACK_BOT_TOKEN=
# Token PERSONAL (xoxp-): el tablero manda el aviso a QA «como vos». Scopes: chat:write, im:write,
# users:read, users:read.email
SLACK_USER_TOKEN=
# App Credentials (Basic Information): hoy no las lee ningún código; sólo harían falta con OAuth2.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ── jev (TypeSafe) ──────────────────────────────────────────────────────────────────────────────────
# Hoy nada lo usa: queda el transporte para cuando aterrice un uso. Se acepta también TYPESAFE_API_KEY.
JEV_TOKEN=

# ── twilio ──────────────────────────────────────────────────────────────────────────────────────────
# Sólo lectura (pg twilio …). SID+TOKEN es la credencial de la cuenta y la que sirve para casi todo; la
# API Key (SK…) necesita su secret, que Twilio muestra UNA vez; la app OAuth (OQ…) autentica sin permisos.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_CLIENT_ID=
TWILIO_CLIENT_SECRET=
