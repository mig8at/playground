# connectors/.env.<target> — las credenciales de los conectores, UN archivo por ambiente
# (local · dev · qa · staging · prod). Fuera de git: copiá esta plantilla a .env.<target> y completá.
# Las variables del proceso ganan sobre el archivo. Qué conector lee qué: connectors/<conector>/.

# ── sql ─────────────────────────────────────────────────────────────────────────────────────────────
# Con E2E_DB_HOST se usa MySQL directo (local · dev · qa · staging). Son los mismos nombres del harness.
# ⚠ El prefijo E2E_DB_ va A PROPÓSITO: DB_HOST y DB_PORT son los nombres que lee Laravel, y un
#   `set -a; . este-archivo` dejaría cualquier `artisan` apuntando a esta base. Por eso el conector NO
#   lee DB_HOST ni del archivo ni del proceso.
# ⚠ qa y staging leen la MISMA base que dev: el resultado dice qué host contestó.
E2E_DB_HOST=
E2E_DB_PORT=3306
E2E_DB_NAME=
E2E_DB_USER=
E2E_DB_PASS=
# Sin E2E_DB_HOST se usa Redash: es el camino de prod, donde no hay acceso directo y cada consulta queda
# auditada a nombre del token. Pide la VPN de prod (el balanceador es interno).
REDASH_URL=
REDASH_TOKEN=
# 1 = «Live» (rds_mysql) de producción, que es el default
REDASH_DATA_SOURCE_ID=
# la zona en que Redash devuelve los datetime (default America/Bogota)
REDASH_TZ=

# ── logs ────────────────────────────────────────────────────────────────────────────────────────────
# local → el Loki de esta máquina (harness/bin/loki-local), sin credenciales ·
# dev · qa · staging → el stack creditopdev · prod → el stack creditop. Se aceptan los GRAFANA_LOKI_* de
# legacy-backend. Los dos stacks viven en la misma región: misma URL (logs-prod-036) y mismo token, y lo que
# cambia es LOKI_USER, que es POR STACK (creditop 1339721 · creditopdev 1339770).
LOKI_URL=
# el ID NUMÉRICO de la instancia de logs (6-7 dígitos): no el org del token, ni el slug, ni un email. Sin él,
# Grafana Cloud rechaza con `legacy auth cannot be upgraded`, que engaña porque suena a URL equivocada.
LOKI_USER=
# el glc_ de la access policy, con el scope logs:read
LOKI_TOKEN=
# sólo un Loki self-hosted detrás de un gateway lo necesita
LOKI_TENANT=
# SÍ filtra la etiqueta `environment` (alternativa de regex). En creditopdev los PHP de dev y de qa
# loguean los dos `development`: esto deja afuera las máquinas de desarrollo, no separa dev de qa.
LOKI_ENV=
# el service_name del monolito de este ambiente (dev → legacy-backend, qa → CreditopDev). NO filtra: sirve
# para decir qué backend sirvió cada línea.
LOKI_SERVICE=
