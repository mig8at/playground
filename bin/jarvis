#!/bin/sh
# jarvis — el CLI de la sesión en vivo de Jarvis (jarvis/cli). Lo compila la primera vez y cada vez
# que cambia su código, a ~/.cache/playground/jarvis, igual que bin/pg. Habla con la API de `make jarvis`.
root=$(cd "$(dirname "$0")/.." && pwd -P) || exit 1
bin="${XDG_CACHE_HOME:-$HOME/.cache}/playground/jarvis"
stale=$(find "$root/jarvis/cli" "$root/jarvis/docs" -type f -newer "$bin" 2>/dev/null | head -n 1)
if [ ! -x "$bin" ] || [ -n "$stale" ]; then
  mkdir -p "$(dirname "$bin")" || exit 1
  tmp="$bin.$$"
  if ! (cd "$root" && go build -o "$tmp" ./jarvis/cli) >&2; then
    rm -f "$tmp"
    echo "jarvis: no compila jarvis/cli" >&2
    exit 1
  fi
  mv -f "$tmp" "$bin"
fi
JARVIS_ROOT="$root" exec "$bin" "$@"
