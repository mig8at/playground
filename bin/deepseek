#!/bin/sh
# deepseek — DeepSeek por su web, en tu Chrome con Jarvis y con tu sesión (sin llave de API). Es la receta de
# jarvis/recipes/deepseek/; los archivos se leen y se escriben desde donde lo corrés.
#   bin/deepseek [ask] --prompt '…' [--file doc.md] [--no-think] [--search] [--out r.md] [--keep] [--json]
root=$(cd "$(dirname "$0")/.." && pwd -P) || exit 1
case "$1" in
  # La ayuda no abre Chrome ni le pregunta nada al modelo: es el encabezado de este archivo.
  help|-h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
  ask) recipe=$1; shift ;;
  *) recipe=ask ;;
esac
exec node "$root/jarvis/recipes/deepseek/$recipe.ts" "$@"
