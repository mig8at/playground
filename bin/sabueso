#!/bin/sh
# sabueso — encontrar comercios y su contacto para la propuesta, por consola (sabueso/cli). Habla con la API de
# la app de Cockpit. Lo compila la primera vez y cada vez que cambia su código, a
# ~/.cache/my-tools/sabueso (como bin/pg): `go run` costaría un segundo por llamada.
root=$(cd "$(dirname "$0")/.." && pwd -P) || exit 1
bin="${XDG_CACHE_HOME:-$HOME/.cache}/my-tools/sabueso"
stale=$(find "$root/sabueso/cli" -name '*.go' -newer "$bin" 2>/dev/null | head -n 1)
if [ ! -x "$bin" ] || [ -n "$stale" ] || [ "$root/go.mod" -nt "$bin" ]; then
  mkdir -p "$(dirname "$bin")" || exit 1
  tmp="$bin.$$"
  if ! (cd "$root" && go build -o "$tmp" ./sabueso/cli) >&2; then
    rm -f "$tmp"
    echo "sabueso: no compila sabueso/cli" >&2
    exit 1
  fi
  mv -f "$tmp" "$bin"
fi
MY_TOOLS_ROOT="${MY_TOOLS_ROOT:-$root}" exec "$bin" "$@"
