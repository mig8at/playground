{
  "name": "creditop-ecommerce-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web,share -c green,cyan,magenta \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:share\"",
    "dev:server": "go run ./server -serve 127.0.0.1:5187",
    "dev:web": "vite",
    "build": "vite build",
    "dev:share": "node scripts/share.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7"
  }
}
