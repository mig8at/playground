#!/usr/bin/env bash
# Mock de la API de BANCOLOMBIA — los dos productos: BNPL (68) y Consumo (100).
#
# En local `BANCOLOMBIA_HOST=https://bancolombia.fake` es un placeholder A PROPÓSITO: sin este mock los
# 8 pasos de BNPL y los 11 de Consumo mueren con `cURL error 6: Could not resolve host`, el flujo no
# llega al estado 25 y el código de compra no se puede ejercitar.
#
# Apuntá el backend en legacy-backend/.env (Docker → host.docker.internal, y por HTTP):
#   BANCOLOMBIA_HOST=http://host.docker.internal:8104
#   BANCOLOMBIA_AUTH_HOST=http://host.docker.internal:8104
#
# Control en caliente (sin reiniciar):
#   curl -s localhost:8104 | jq                      # escenario + últimas llamadas
#   curl -sX POST localhost:8104/_control/escenario -H 'content-type: application/json' \
#        -d '{"hasQuota":false}'                     # sin cupo
#   curl -sX POST localhost:8104/_control/escenario -H 'content-type: application/json' \
#        -d '{"errorCode":"BP40920507"}'             # 409 sin cupo del banco
#   curl -sX POST localhost:8104/_control/reset
#
# uso: bin/mock-bancolombia [start|stop|status|logs]
#   env: MOCK_BC_PORT (8104) · MOCK_BC_FAIL=1 → todo responde 500 SP500
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${MOCK_BC_PORT:-8104}"
LOG=/tmp/mock-bancolombia.log

up() { curl -s -o /dev/null --max-time 2 "http://localhost:$PORT" 2>/dev/null; }

case "${1:-start}" in
  start)
    WANT_FAIL="${MOCK_BC_FAIL:-0}"
    if up; then
      CUR="$(curl -s --max-time 2 "http://localhost:$PORT" 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.stdout.write(JSON.parse(s).fail?"1":"0")}catch{process.stdout.write("0")}})')"
      if [ "${CUR:-0}" = "$WANT_FAIL" ]; then echo "✓ mock-bancolombia ya arriba (:$PORT)"; exit 0; fi
      echo "↻ reinicio mock-bancolombia (modo fallo: ${CUR:-0} → $WANT_FAIL)"
      lsof -ti:"$PORT" 2>/dev/null | xargs kill -9 2>/dev/null || true
      for _ in $(seq 1 10); do up || break; sleep 0.2; done
    fi
    rm -f "$LOG"
    nohup env MOCK_BC_PORT="$PORT" MOCK_BC_FAIL="$WANT_FAIL" \
      node "$DIR/mock-bancolombia/server.mjs" < /dev/null > "$LOG" 2>&1 &
    for _ in $(seq 1 25); do up && { echo "✓ mock-bancolombia :$PORT"; exit 0; }; sleep 0.3; done
    echo "✗ no levantó"; tail -8 "$LOG" 2>/dev/null; exit 1;;
  stop)
    lsof -ti:"$PORT" 2>/dev/null | xargs kill -9 2>/dev/null && echo "⏹ detenido (:$PORT)" || echo "no estaba corriendo";;
  status)
    if up; then curl -s --max-time 2 "http://localhost:$PORT" 2>/dev/null; echo ""; else echo "○ off (:$PORT)"; fi;;
  logs)
    tail -n "${2:-40}" "$LOG" 2>/dev/null || echo "(sin log)";;
  *)
    echo "uso: bin/mock-bancolombia [start|stop|status|logs]";;
esac
