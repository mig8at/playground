# Plantilla versionada. Copiala a `.env` (gitignoreado) y completá la key.
#
#   cp .env.example .env

# API key de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Qué modelo usar. Si el que está acá no existe o no está habilitado para tu key,
# `make agente-modelos` lista los que SÍ podés usar hoy — pegá uno de esos.
GEMINI_MODEL=gemini-3.7-flash

# Tope de vueltas del bucle (herramienta → resultado → herramienta …) antes de cortar.
# Existe para que un modelo confundido no pida la misma función para siempre.
MAX_PASOS=12
