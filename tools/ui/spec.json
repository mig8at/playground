      "html": "<div class=\"row\"><span class=\"ui-icon\" data-icon=\"server\" aria-hidden=\"true\"></span><span>Solicitud 519245</span><span class=\"row-meta\">hoy</span><div class=\"row-actions\"><button class=\"region-action\" title=\"Renombrar\" aria-label=\"Renombrar\"><span class=\"ui-icon\" data-icon=\"settings\" aria-hidden=\"true\"></span></button><button class=\"region-action\" title=\"Quitar\" aria-label=\"Quitar\"><span class=\"ui-icon\" data-icon=\"close\" aria-hidden=\"true\"></span></button></div></div>",
