    {
      "group": "Opciones de una región",
      "id": "panel-max",
      "name": "Consola maximizada",
      "cls": ".workbench.panel-max",
      "html": "<div class=\"workbench panel-max\" style=\"height:240px\"><main class=\"editor\">editor</main><section class=\"panel\"><div class=\"region-head\"><span>Consola</span><div class=\"region-actions\"><button class=\"region-action\" aria-pressed=\"true\" title=\"Restaurar la consola\" aria-label=\"Restaurar la consola\"><span class=\"ui-icon\" data-icon=\"restore\" aria-hidden=\"true\"></span></button></div></div></section></div>",
      "target": ".panel",
      "measure": {
        "height": 240
      },
      "parts": {
        ".editor": {
          "display": "none"
        }
      },
      "use": "El botón de la banda de la consola le da todo el alto de la columna y tapa el editor. Temporal: no se guarda, y se deshace con el mismo botón o con Escape."
    },
    {
      "group": "Opciones de una región",
