      "html": "<div class=\"panes\" style=\"width:800px;height:120px\"><section class=\"pane\"><nav class=\"tabs\"><button class=\"tab on\">Antes</button></nav></section><section class=\"pane\"><nav class=\"tabs\"><button class=\"tab on\">Después</button></nav></section></div>",
      "target": ".pane",
      "measure": {
        "width": 400
      },
      "parts": {
        ".pane + .pane": {
          "width": 400,
          "borderLeftWidth": 1
        },
        ".tabs": {
          "height": 40
        }
      },
      "use": "Dos cosas lado a lado dentro del editor, para comparar. Mitad y mitad, cada una con su banda de 40."
    },
    {
      "group": "Opciones de una región",
      "id": "panes-folded",
      "name": "Dos paneles, editor angosto",
      "cls": ".panes › .pane",
      "html": "<div class=\"panes\" style=\"width:700px;height:80px\"><section class=\"pane\"></section><section class=\"pane\"></section></div>",
