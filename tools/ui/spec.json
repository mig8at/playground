      "html": "<div class=\"log-line\"><span class=\"log-time\">12:41:03</span><span>identidad · validada</span></div>",
      "measure": {
        "paddingLeft": 12,
        "gap": 12,
        "fontSize": 12,
        "lineHeight": 20
      },
      "parts": {
