{
  "name": "creditop-plantillas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cd server && go run . -puerto 8090",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server:build": "cd server && go build -o bin/plantillas .",
    "server:check": "cd server && go vet ./..."
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "vite": "^6.0.7"
  }
}
