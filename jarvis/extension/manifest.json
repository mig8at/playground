{
  "manifest_version": 3,
  "name": "Jarvis",
  "version": "0.2.10",
  "description": "Claude trabaja a tu lado en este Chrome: maneja las pestañas que le compartís (y las que abre) por el navegador de my-tools (127.0.0.1:5203). El ícono abre el panel lateral con los grupos abiertos y sus pestañas.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:5203/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jarvis",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
