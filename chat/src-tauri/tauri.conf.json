{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chat",
  "version": "0.1.0",
  "identifier": "com.creditop.playground.chat-app",
  "build": {
    "frontendDist": "http://127.0.0.1:5185",
    "devUrl": "http://127.0.0.1:5185"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "chat", "width": 1280, "height": 820, "minWidth": 380, "minHeight": 480 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "SocialNetworking",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
