{
  "name": "creditop-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web,agents -c green,cyan,magenta \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:agents\"",
    "dev:server": "cd .. && go run ./chat/server -serve 127.0.0.1:5185",
    "dev:web": "vite",
    "dev:agents": "sh scripts/agents.sh",
    "build": "vite build"
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "three": "^0.169.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7"
  }
}
