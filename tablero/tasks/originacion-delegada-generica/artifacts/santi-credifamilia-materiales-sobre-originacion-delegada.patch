index 000000000..36350099c
--- /dev/null
+++ b/tests/Unit/Lenders/CredifamiliaConsumo/MaterialesFourPerThousandOfficialCasesTest.php
@@ -0,0 +1,220 @@
+<?php
+
+namespace Tests\Unit\Lenders\CredifamiliaConsumo;
+
+use App\Actions\Lenders\CredifamiliaConsumo\CredifamiliaConsumo;
+use App\Actions\Lenders\CredifamiliaConsumo\TransactionRequest;
+use App\Models\Allied;
+use App\Models\User;
+use App\Models\UserRequest;
+use App\Otel\TracerService;
+use App\Services\PaymentPlan\DelegatedOrigination\PaymentPlanPayloadBuilder;
+use App\Services\PaymentPlan\DelegatedOrigination\PaymentPlanCalculatorService;
+use App\Services\PaymentPlan\DelegatedOrigination\Engine\AmortizationEngine;
+use App\Services\PaymentPlan\DelegatedOrigination\Engine\ScheduleGenerator;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+use Modules\Loans\Contracts\Repositories\UserFieldValueRepositoryInterface;
+use Modules\Onboarding\App\Services\lenders\CredifamiliaConsumo\CredifamiliaConsumoService;
+use ReflectionMethod;
+use ReflectionProperty;
+use Tests\TestCase;
+
+/**
+ * Los casos de prueba oficiales de Credifamilia para Materiales, con 4x1000 (Credifamilia confirmó
+ * que aplica): el % sale de la tabla FNG al plazo, el motor calcula la fianza y la radicación SOAP
+ * lleva el mismo montoTotalCredito.
+ *
+ * Los valores van al centavo, como los calcula el motor hoy. El documento oficial redondea a pesos
+ * el montoTotalCredito (y el Total Fianza del caso 3); eso se fija aparte con round(…, 0).
+ *
+ * WHY sqlite in-memory: mismo montaje que SoapPayloadMaterialesTest (migraciones reales de la tabla
+ * FNG y promissory_notes para el SOAP).
+ */
+class MaterialesFourPerThousandOfficialCasesTest extends TestCase
+{
+    private const CONNECTION = 'sqlite_in_memory_materiales_official_cases_test';
+
+    private const MATERIALES_DEVELOP = 216;
+
+    /** Preaprobado de Materiales SIN guarantee_percentage ni guarantee_type. */
+    private const TRANSACTION_DATA = [
+        'annual_effective_rate'     => 28.17,
+        'monthly_rate'              => 0.020898,
+        'life_insurance_percentage' => 0.1307,
+        'max_amount'                => 12000000,
+    ];
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        config([
+            'database.default' => self::CONNECTION,
+            'database.connections.'.self::CONNECTION => [
+                'driver' => 'sqlite',
+                'database' => ':memory:',
+                'prefix' => '',
+                'foreign_key_constraints' => true,
+            ],
+        ]);
+
+        DB::purge();
+        DB::setDefaultConnection(self::CONNECTION);
+        $this->app['env'] = 'develop';
+
+        Schema::create('lenders', function (Blueprint $table) {
+            $table->id();
+            $table->timestamps();
+        });
+        Schema::create('promissory_notes', function (Blueprint $table) {
+            $table->id();
+            $table->unsignedBigInteger('user_request_id');
+            $table->text('deceval_response_data')->nullable();
+            $table->timestamps();
+        });
+        DB::table('lenders')->insert(['id' => self::MATERIALES_DEVELOP, 'created_at' => now(), 'updated_at' => now()]);
+
+        foreach ([
+            'database/migrations/2026_10_20_120000_create_lender_term_fng_percentages_table.php',
+            'database/migrations/2026_10_20_120100_seed_fng_percentages_for_credifamilia_materiales.php',
+            'database/migrations/2026_10_30_120000_create_delegated_origination_profiles_table.php',
+            'database/migrations/2026_10_30_120100_seed_delegated_origination_profiles_for_credifamilia.php',
+        ] as $migration) {
+            (require base_path($migration))->up();
+        }
+    }
+
+    protected function tearDown(): void
+    {
+        Schema::dropIfExists('delegated_origination_profiles');
+        Schema::dropIfExists('lender_term_fng_percentages');
+        Schema::dropIfExists('promissory_notes');
+        Schema::dropIfExists('lenders');
+        DB::purge(self::CONNECTION);
+
+        parent::tearDown();
+    }
+
+    /**
+     * @dataProvider officialCasesProvider
+     */
+    public function test_official_case_matches_engine_and_soap(
+        int $amount,
+        int $term,
+        float $fngPercentage,
+        float $bondBase,
+        float $bondIva,
+        float $fourPerThousand,
+        float $totalBond,
+        string $totalCreditAmount,
+        float $officialTotalCreditAmount,
+    ): void {
+        $userRequest = $this->userRequest($amount, $term);
+
+        $engine = $this->calculator()->calculate(
+            $this->builder()->build($userRequest, ['disbursement_date' => '2026-05-07', 'payment_day' => 16])
+        );
+
+        $this->assertTrue($engine['success']);
+        $this->assertSame($fngPercentage, $engine['inputs']['bond_percentage']);
+        $this->assertSame('Anticipada', $engine['inputs']['bond_type']);
+        $this->assertSame($bondBase, round($engine['derived']['bond_base'], 2));
+        $this->assertSame($bondIva, round($engine['derived']['bond_iva'], 2));
+        $this->assertSame($fourPerThousand, round($engine['derived']['four_per_thousand'], 2));
+        $this->assertSame($totalBond, round($engine['derived']['total_bond'], 2));
+
+        $payload = (new TransactionRequest(
+            $this->buildRequest($userRequest),
+            $this->user(),
+            $userRequest,
+            $this->createMock(UserFieldValueRepositoryInterface::class),
+        ))->build();
+
+        $this->assertSame($totalCreditAmount, $payload['montoTotalCredito']);
+        $this->assertSame(
+            number_format(round($engine['derived']['total_disbursement'], 2), 2, '.', ''),
+            $payload['montoTotalCredito']
+        );
+        $this->assertSame($officialTotalCreditAmount, round((float) $payload['montoTotalCredito'], 0));
+    }
+
+    public static function officialCasesProvider(): array
+    {
+        return [
+            // 95.692 + 18.181,48 = 113.873,48; 4x1000 = 455,49 → Total Fianza 114.328,97
+            'caso 1: 2.545.000 a 24 meses (3,76 %)' => [
+                2545000, 24, 0.0376, 95692.0, 18181.48, 455.49, 114328.97, '2659328.97', 2659329.0,
+            ],
+            // 598.683,93 + 113.749,95 = 712.433,87; 4x1000 = 2.849,74 → Total Fianza 715.283,61
+            'caso 2: 9.563.641 a 48 meses (6,26 %)' => [
+                9563641, 48, 0.0626, 598683.93, 113749.95, 2849.74, 715283.61, '10278924.61', 10278925.0,
+            ],
+            // 218.905,35 + 41.592,02 = 260.497,37; 4x1000 = 1.041,99 → Total Fianza 261.539,36
+            // (el documento oficial lo muestra redondeado: 261.539)
+            'caso 3: 8.756.214 a 12 meses (2,50 %)' => [
+                8756214, 12, 0.025, 218905.35, 41592.02, 1041.99, 261539.36, '9017753.36', 9017753.0,
+            ],
+        ];
+    }
+
+    private function buildRequest(UserRequest $userRequest): Request
+    {
+        $service = new CredifamiliaConsumoService(
+            $this->createMock(CredifamiliaConsumo::class),
+            $this->createMock(UserFieldValueRepositoryInterface::class),
+            $this->builder(),
+            $this->createMock(TracerService::class),
+        );
+
+        $method = new ReflectionMethod(CredifamiliaConsumoService::class, 'buildRequest');
+        $method->setAccessible(true);
+
+        return $method->invoke($service, $userRequest);
+    }
+
+    private function builder(): PaymentPlanPayloadBuilder
+    {
+        $builder = new PaymentPlanPayloadBuilder();
+        $cache = new ReflectionProperty(PaymentPlanPayloadBuilder::class, 'preApprovalCache');
+        $cache->setAccessible(true);
+        $cache->setValue($builder, [4242 => ['status' => 'approved', 'transaction_data' => self::TRANSACTION_DATA]]);
+
+        return $builder;
+    }
+
+    private function userRequest(int $amount, int $feeNumber): UserRequest
+    {
+        $userRequest = new UserRequest();
+        $userRequest->id = 4242;
+        $userRequest->user_id = 77;
+        $userRequest->lender_id = self::MATERIALES_DEVELOP;
+        $userRequest->allied_id = 5;
+        $userRequest->allied_branch_id = 9;
+        $userRequest->amount = $amount;
+        $userRequest->fee_number = $feeNumber;
+        $userRequest->selected_payment_date = '2026-06-16';
+        $allied = new Allied(['name' => 'Gaes', 'nit' => '900123456']);
+        $allied->setRelation('industry', null);
+        $userRequest->setRelation('allied', $allied);
+
+        return $userRequest;
+    }
+
+    private function user(): User
+    {
+        $user = new User();
+        $user->id = 77;
+        $user->document_type = 'CC';
+        $user->setRelation('datacredito', null);
+
+        return $user;
+    }
+
+    private function calculator(): PaymentPlanCalculatorService
+    {
+        return new PaymentPlanCalculatorService(new AmortizationEngine(new ScheduleGenerator()));
+    }
+}
