diff --git a/tests/Unit/Lenders/CredifamiliaConsumo/MaterialesFourPerThousandOfficialCasesTest.php b/tests/Unit/Lenders/CredifamiliaConsumo/MaterialesFourPerThousandOfficialCasesTest.php
