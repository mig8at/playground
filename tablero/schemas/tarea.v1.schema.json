{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creditop.local/tablero/schemas/tarea.v1.schema.json",
  "title": "Proyección estructurada de una tarea del tablero",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tarea", "estado", "trabajo", "secciones", "publicacion"],
  "properties": {
    "schemaVersion": { "const": "tablero.tarea.v1" },
    "tarea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "id", "title", "stage", "archived", "archivo"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "id": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["evaluation", "work", "tasks"] },
        "clase": { "enum": ["tarea", "proyecto"] },
        "archived": { "type": "boolean" },
        "jira": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "canon": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "archivo": { "type": "string", "minLength": 1 }
      }
    },
    "estado": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retoma", "proximoPaso"],
      "properties": {
        "retoma": { "type": "string" },
        "proximoPaso": { "type": "string" }
      }
    },
    "trabajo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conteos", "pendientes", "anotaciones"],
      "properties": {
        "conteos": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pendientesAbiertos", "pendientesCerrados", "mediciones", "decisiones", "preguntas", "riesgos"],
          "properties": {
            "pendientesAbiertos": { "type": "integer", "minimum": 0 },
            "pendientesCerrados": { "type": "integer", "minimum": 0 },
            "mediciones": { "type": "integer", "minimum": 0 },
            "decisiones": { "type": "integer", "minimum": 0 },
            "preguntas": { "type": "integer", "minimum": 0 },
            "riesgos": { "type": "integer", "minimum": 0 }
          }
        },
        "pendientes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["que", "hecho", "seccion"],
            "properties": {
              "que": { "type": "string" },
              "hecho": { "type": "boolean" },
              "seccion": { "type": "string" }
            }
          }
        },
        "anotaciones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "fecha", "quien", "que", "como"],
            "properties": {
              "tipo": { "enum": ["medicion", "decision", "pregunta", "riesgo"] },
              "fecha": { "type": "string", "format": "date" },
              "quien": { "type": "string" },
              "que": { "type": "string" },
              "como": { "type": "string" },
              "fuentes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "secciones": { "type": "array", "items": { "type": "string" } },
    "publicacion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disponible", "listaParaJira", "tieneQA", "bytes", "violaciones"],
      "properties": {
        "disponible": { "type": "boolean" },
        "listaParaJira": { "type": "boolean" },
        "tieneQA": { "type": "boolean" },
        "bytes": { "type": "integer", "minimum": 0 },
        "violaciones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "borrador": { "type": "string" }
      }
    }
  }
}
