# Copiá este archivo como .env.local, .env.dev, .env.staging o .env.prod.
# Usá una sola fuente por ambiente.

# MySQL directo (local, dev o staging)
TABLERO_DB_HOST=
TABLERO_DB_PORT=3306
TABLERO_DB_NAME=
TABLERO_DB_USER=
TABLERO_DB_PASSWORD=

# Redash de solo lectura (normalmente prod)
TABLERO_DB_REDASH_URL=
TABLERO_DB_REDASH_TOKEN=
TABLERO_DB_REDASH_DATA_SOURCE=1
