{
  "name": "creditop-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cd server && go run ./cmd/web",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "server:build": "cd server && go build -o bin/web ./cmd/web && go build -o bin/pulse ./cmd/pulse"
  },
  "dependencies": {
    "marked": "^18.0.11",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7"
  }
}
