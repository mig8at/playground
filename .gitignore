# Repo LOCAL único del playground. Nunca se pushea (sin remoto).

# Dependencias / builds (JS/TS · Vue)
node_modules/
dist/
.vite/
.cache/
build/
*.tsbuildinfo

# Go (binarios compilados; NO usar *-e2e — colisiona con las carpetas backend-e2e/harness)
vendor/
/backend-e2e/woocommerce-e2e
/backend-e2e/motai-e2e
/backend-mcp/creditop-mcp
*.test
*.out

# SQLite del prototipo `plantillas` (nace en server/ porque el `go run` corre desde ahí;
# se regenera y se siembra solo al arrancar, así que no se versiona). `plantillas.db*` es
# el nombre viejo: el esquema cambió de forma y se dejó el archivo en disco en vez de
# migrarlo — se puede borrar a mano.
/plantillas/server/*.db
/plantillas/server/*.db-shm
/plantillas/server/*.db-wal
/plantillas/server/bin/

# Playwright
playwright-report/
test-results/
.playwright/

# Dumps de BD (pesados — se regeneran con db-dump/dump-dev.sh)
*.sql.gz
*.sql.dump

# Secrets / entorno
.env
.env.*
!.env.example
!.env.*.example
# Artefactos de sesión/tokens del login Cognito (harness/.auth/) — nunca commitear
.auth/
# Ledger de recursos creados en BD (backend-e2e/.created-resources.json) — estado local por máquina
.created-resources.json

# Permisos locales de Claude Code (regla del wrapper dev) — machine-local, no commitear
.claude/settings.local.json

# SO / editor
.DS_Store
*.log
.idea/
.vscode/

# Volcado forense pre-scrub (harness/.runs/) — estado de solicitudes por corrida, local por máquina
.runs/

# base local de cuadrilla
cuadrilla.db
cuadrilla.db-*
